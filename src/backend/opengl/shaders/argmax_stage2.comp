#version 310 es
precision highp float;
precision highp int;
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer PartialBuf {
	uvec2 partials[];
};
layout(std430, binding = 1) buffer OutBuf {
	uint out_idx[];
};
layout(location = 0) uniform int u_groups;
layout(location = 1) uniform int u_slot;
shared float s_val[64];
shared uint	 s_idx[64];
void		 main(void) {
	uint  tid	 = gl_LocalInvocationID.x;
	uint  n		 = uint(u_groups);
	float my_val = uintBitsToFloat(0xFF800000u);
	uint  my_idx = 0u;
	for (uint i = tid; i < n; i += 64u) {
		uvec2 p = partials[i];
		float v = uintBitsToFloat(p.x);
		if (v > my_val || (v == my_val && p.y < my_idx)) {
			my_val = v;
			my_idx = p.y;
		}
	}
	s_val[tid] = my_val;
	s_idx[tid] = my_idx;
	barrier();
	for (uint s = 32u; s > 0u; s >>= 1u) {
		if (tid < s) {
			float ov = s_val[tid + s];
			float mv = s_val[tid];
			if (ov > mv || (ov == mv && s_idx[tid + s] < s_idx[tid])) {
				s_val[tid] = ov;
				s_idx[tid] = s_idx[tid + s];
			}
		}
		barrier();
	}
	if (tid == 0u)
		out_idx[u_slot] = s_idx[0];
}

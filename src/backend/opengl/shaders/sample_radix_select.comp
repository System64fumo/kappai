#version 310 es
precision highp float;
precision highp int;
layout(local_size_x = 256) in;

layout(std430, binding = 0) coherent buffer StateBuf {
	uint state[];
};

layout(location = 0) uniform int u_shift;
layout(location = 1) uniform int u_k;

shared uint s_bucket;

void main() {
	uint tid = gl_LocalInvocationID.x;
	if (tid == 0u) {
		uint k_rem	= u_shift == 24 ? uint(u_k) : state[257];
		uint prefix = u_shift == 24 ? 0u : state[256];
		uint acc	= 0u;
		uint chosen = 0u;
		for (int b = 255; b >= 0; b--) {
			uint c = state[b];
			if (acc + c >= k_rem) {
				chosen = uint(b);
				break;
			}
			acc += c;
		}
		state[257] = k_rem - acc;
		state[256] = (prefix << 8) | chosen;
		if (u_shift == 0)
			state[259] = 0u;
	}
	memoryBarrierBuffer();
	barrier();
	state[tid] = 0u;
}

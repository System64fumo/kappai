#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer WBuf {
	uint w[];
};
layout(std430, binding = 1) readonly buffer XBuf {
	float x[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k_blocks;
layout(location = 2) uniform int u_add_residual;

shared float s_acc[32];
shared float s_amax[32];
shared float s_maxv[32];

float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}

uint rb(uint off) {
	uint wd = w[off >> 2u];
	return (wd >> ((off & 3u) * 8u)) & 0xFFu;
}

int ri8(uint off) {
	uint v = rb(off);
	return v >= 128u ? int(v) - 256 : int(v);
}

uint f32_bits(float f) {
	return floatBitsToUint(f);
}
float bits_f32(uint b) {
	return uintBitsToFloat(b);
}

uint exact_div(uint nb, uint db) {
	uint Nn	 = (nb & 0x7FFFFFu) | 0x800000u;
	uint Dd	 = (db & 0x7FFFFFu) | 0x800000u;
	int	 eq	 = int((nb >> 23u) & 0xFFu) - int((db >> 23u) & 0xFFu);
	uint M24 = 0u;
	uint rem;
	int	 me;
	if (Nn >= Dd) {
		me	= eq;
		rem = Nn - Dd;
	} else {
		me	= eq - 1;
		rem = (Nn << 1u) - Dd;
	}
	for (int i = 0; i < 23; i++) {
		rem <<= 1u;
		M24 <<= 1u;
		if (rem >= Dd) {
			rem -= Dd;
			M24 |= 1u;
		}
	}
	uint r2 = rem << 1u;
	if (r2 > Dd || (r2 == Dd && (M24 & 1u) == 1u))
		M24++;
	if (M24 >= (1u << 23)) {
		M24 = 0u;
		me++;
	}
	int fe = me + 127;
	if (fe >= 255)
		return 0x7F800000u;
	if (fe <= 0)
		return 0u;
	return (uint(fe) << 23u) | M24;
}

int round_away(float f) {
	float af = abs(f);
	float tr = trunc(af);
	float fr = af - tr;
	float r	 = (fr >= 0.5) ? (tr + 1.0) : tr;
	return (f < 0.0) ? -int(r) : int(r);
}

void main(void) {
	uint row   = gl_WorkGroupID.x + gl_WorkGroupID.y * 65535u;
	uint tid   = gl_LocalInvocationID.x;
	bool valid = int(row) < u_n;

	float acc = 0.0;
	if (valid) {
		uint row_off = row * uint(u_k_blocks) * 210u;
		int	 nch	 = u_k_blocks * 4;
		int	 iters	 = (nch + 31) / 32;
		for (int it = 0; it < iters; it++) {
			int	  c	   = it * 32 + int(tid);
			int	  bi   = c >> 2;
			int	  ch   = c & 3;
			int	  xsb  = bi * 256;
			int	  xb   = xsb + ch * 64;
			float amax = 0.0;
			float maxv = 0.0;
			if (c < nch) {
				for (int j = 0; j < 64; j++) {
					float v	 = x[xb + j];
					float ax = abs(v);
					if (ax > amax) {
						amax = ax;
						maxv = v;
					}
				}
			}
			s_amax[tid] = amax;
			s_maxv[tid] = maxv;
			barrier();
			if (c < nch) {
				int t0 = int(tid) & ~3;
				for (int q = 0; q < 4; q++) {
					if (s_amax[t0 + q] > amax) {
						amax = s_amax[t0 + q];
						maxv = s_maxv[t0 + q];
					}
				}
				if (amax != 0.0) {
					uint  bo	 = row_off + uint(bi) * 210u;
					float iscale = -127.0 / maxv;
					float dxq	 = 1.0 / iscale;
					float dw	 = h2f(rb(bo + 208u) | (rb(bo + 209u) << 8u));
					int	  sumi	 = 0;
					for (int sub = ch * 4; sub < ch * 4 + 4; sub++) {
						int scale	= ri8(bo + 192u + uint(sub));
						int sbit	= sub >> 3;
						int grp		= (sub >> 1) & 3;
						int lhalf	= sub & 1;
						int sub_sum = 0;
						for (int j = 0; j < 16; j++) {
							int	 l	 = lhalf * 16 + j;
							int	 cx	 = (sub << 4) + j;
							uint qlo = rb(bo + uint(sbit * 64 + (grp & 1) * 32 + l));
							int	 lo	 = (grp & 2) == 0 ? int(qlo & 0xFu) : int(qlo >> 4);
							uint qhb = rb(bo + uint(128 + sbit * 32 + l));
							int	 a	 = (lo | (int((qhb >> uint(2 * grp)) & 3u) << 4)) - 32;
							int	 v	 = round_away(iscale * x[xsb + cx]);
							v		 = v > 127 ? 127 : (v < -127 ? -127 : v);
							sub_sum += v * a;
						}
						sumi += scale * sub_sum;
					}
					acc += dw * dxq * float(sumi);
				}
			}
			barrier();
		}
	}
	s_acc[tid] = acc;
	barrier();
	for (uint s = 16u; s > 0u; s >>= 1u) {
		if (tid < s)
			s_acc[tid] += s_acc[tid + s];
		barrier();
	}
	if (valid && tid == 0u) {
		if (u_add_residual == 1)
			y[row] = s_acc[0] + res[row];
		else if (u_add_residual == 2)
			y[row] += s_acc[0];
		else
			y[row] = s_acc[0];
	}
}

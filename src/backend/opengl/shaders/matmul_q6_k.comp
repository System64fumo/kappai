#version 310 es
precision highp float;
precision highp int;

#ifndef WG
#define WG 32
#endif
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer WBuf {
	uint w[];
};
layout(std430, binding = 1) readonly buffer XQBuf {
	uint xq[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k_blocks;
layout(location = 2) uniform int u_add_residual;
layout(location = 9) uniform int u_m;
layout(location = 10) uniform int u_x_stride;
layout(location = 11) uniform int u_wg_base;

uint g_mi;

#define ROWS 4
#define NIB 0x000F000Fu

shared float s_acc[ROWS][WG];

float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}

int pair_field_sum(uint acc) {
	uint low = uint(bitfieldExtract(int(acc), 0, 16));
	return int(acc - low) >> 16;
}

#define CENTER32 0x00200020u

uint rb(uint off) {
	uint wd = w[off >> 2u];
	return (wd >> ((off & 3u) * 8u)) & 0xFFu;
}

uint ld32(uint off) {
	uint a	= w[off >> 2u];
	uint sh = (off & 3u) * 8u;
	if (sh == 0u)
		return a;
	return (a >> sh) | (w[(off >> 2u) + 1u] << (32u - sh));
}

int ri8(uint off) {
	uint v = rb(off);
	return v >= 128u ? int(v) - 256 : int(v);
}

uvec4 load_span(uint wbase, uint par) {
	uint a = w[wbase];
	uint b = w[wbase + 1u];
	uint c = w[wbase + 2u];
	uint d = w[wbase + 3u];
	if (par == 0u)
		return uvec4(a, b, c, d);
	uint e = w[wbase + 4u];
	return uvec4((a >> 16u) | (b << 16u), (b >> 16u) | (c << 16u), (c >> 16u) | (d << 16u),
				 (d >> 16u) | (e << 16u));
}

void main(void) {
	uint wgid = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	  = uint(max(u_m, 1));
	g_mi	  = wgid % mb;
	wgid	  = wgid / mb;
	uint row0 = wgid * uint(ROWS);
	uint tid  = gl_LocalInvocationID.x;
	uint last = uint(max(u_n - 1, 0));

	float acc[ROWS];
	for (int r = 0; r < ROWS; r++)
		acc[r] = 0.0;
	int nch	  = u_k_blocks * 4;
	int iters = (nch + WG - 1) / WG;
	for (int it = 0; it < iters; it++) {
		int c	= it * WG + int(tid);
		int bi	= c >> 2;
		int it4 = c & 3;
		if (c >= nch)
			continue;
		uint  xbq = g_mi * uint(u_x_stride) + uint(bi) * 209u;
		float xd  = uintBitsToFloat(xq[xbq + 64u]);
		if (xd == 0.0)
			continue;
		int sbit  = it4 >> 1;
		int lhalf = it4 & 1;
		for (int r = 0; r < ROWS; r++) {
			uint  blk  = (min(row0 + uint(r), last) * uint(u_k_blocks) + uint(bi));
			uint  bo   = blk * 210u;
			uint  par  = blk & 1u;
			uint  la   = (bo + uint(sbit * 64 + lhalf * 16)) >> 2u;
			uint  lh   = (bo + uint(128 + sbit * 32 + lhalf * 16)) >> 2u;
			uvec4 qa   = load_span(la, par);
			uvec4 qb   = load_span(la + 8u, par);
			uvec4 qh   = load_span(lh, par);
			int	  sumi = 0;
			for (int grp = 0; grp < 4; grp++) {
				int	 sub  = sbit * 8 + grp * 2 + lhalf;
				uint xp	  = xbq + 81u + uint(sub) * 8u;
				uint ls	  = uint((grp >> 1) * 4);
				uint hs	  = uint(grp * 2);
				int	 ssum = 0;
				for (int half_i = 0; half_i < 2; half_i++) {
					uint a = 0u;
					for (int jw = half_i * 2; jw < half_i * 2 + 2; jw++) {
						uint ql	  = (grp & 1) == 0 ? qa[jw] : qb[jw];
						uint hq	  = qh[jw];
						uint hi_a = (hs < 4u ? (hq << (4u - hs)) : (hq >> (hs - 4u))) & 0x00300030u;
						uint hi_b = (hq >> (hs + 4u)) & 0x00300030u;
						uint wa	  = (((ql >> ls) & NIB) | hi_a) - CENTER32;
						uint wb	  = (((ql >> (ls + 8u)) & NIB) | hi_b) - CENTER32;
						a += wa * xq[xp + uint(jw * 2)] + wb * xq[xp + uint(jw * 2) + 1u];
					}
					ssum += pair_field_sum(a);
				}
				sumi += ri8(bo + 192u + uint(sub)) * ssum;
			}
			float dw = h2f(rb(bo + 208u) | (rb(bo + 209u) << 8u));
			acc[r] += dw * xd * float(sumi);
		}
	}
	for (int r = 0; r < ROWS; r++)
		s_acc[r][tid] = acc[r];
	barrier();
	for (uint s = uint(WG) / 2u; s > 0u; s >>= 1u) {
		if (tid < s)
			for (int r = 0; r < ROWS; r++)
				s_acc[r][tid] += s_acc[r][tid + s];
		barrier();
	}
	if (tid < uint(ROWS)) {
		uint row = row0 + tid;
		if (int(row) < u_n) {
			float v = s_acc[tid][0];
			if (u_add_residual == 1)
				y[g_mi * uint(u_n) + row] = v + res[row];
			else if (u_add_residual == 2)
				y[g_mi * uint(u_n) + row] += v;
			else
				y[g_mi * uint(u_n) + row] = v;
		}
	}
}

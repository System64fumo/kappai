#version 310 es
#include "numeric.glsl"
precision highp float;
#define LOAD_BATCH 8
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer XBuf {
	float x[];
};
layout(std430, binding = 1) readonly buffer WBuf {
	float w[];
};
layout(std430, binding = 2) writeonly buffer YBuf {
	float y[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform float u_eps;
shared float s_ss[64];
void		 main(void) {
	uint  tid	  = gl_LocalInvocationID.x;
	int	  n		  = u_n;
	float lane[4] = float[4](0.0, 0.0, 0.0, 0.0);
	for (int i = int(tid); i < n; i += 64) {
		int q	= (i >> 6) & 3;
		lane[q] = num_fma(x[i], x[i], lane[q]);
	}
	lane[0] += lane[2];
	lane[1] += lane[3];
	lane[0] += lane[1];
	s_ss[tid] = lane[0];
	barrier();
	if (tid < 32u) {
		s_ss[tid] += s_ss[tid + 32u];
	}
	barrier();
	if (tid < 16u) {
		s_ss[tid] += s_ss[tid + 16u];
	}
	barrier();
	if (tid < 8u) {
		s_ss[tid] += s_ss[tid + 8u];
	}
	barrier();
	if (tid < 4u) {
		s_ss[tid] += s_ss[tid + 4u];
	}
	barrier();
	if (tid < 2u) {
		s_ss[tid] += s_ss[tid + 2u];
	}
	barrier();
	if (tid < 1u) {
		s_ss[tid] += s_ss[tid + 1u];
	}
	barrier();
	float ss  = s_ss[0];
	float inv = num_rms_scale(ss, n, u_eps);
	for (int i0 = int(tid); i0 < n; i0 += 64 * LOAD_BATCH) {
		float xv[LOAD_BATCH];
		float wv[LOAD_BATCH];
		for (int j = 0; j < LOAD_BATCH; j++) {
			int i = i0 + j * 64;
			xv[j] = i < n ? x[i] : 0.0;
			wv[j] = i < n ? w[i] : 0.0;
		}
		for (int j = 0; j < LOAD_BATCH; j++) {
			int i = i0 + j * 64;
			if (i < n)
				y[i] = xv[j] * inv * wv[j];
		}
	}
}

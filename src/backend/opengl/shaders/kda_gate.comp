#version 310 es
precision highp float;
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer GBuf {
	float g[];
};
layout(std430, binding = 1) readonly buffer DtBuf {
	float dt_bias[];
};
layout(std430, binding = 2) readonly buffer AuxBuf {
	float ssm_a[];
};
layout(std430, binding = 3) buffer BetaBuf {
	float beta[];
};
layout(location = 0) uniform int u_inner;
layout(location = 1) uniform int u_n_heads;
layout(location = 2) uniform int u_head_dim;
layout(location = 3) uniform int u_use_lower_bound;
layout(location = 4) uniform float u_lower_bound;

float sigmoidf(float v) {
	return 1.0 / (1.0 + exp(-v));
}

void main(void) {
	int i = int(gl_GlobalInvocationID.x);
	if (i < u_inner) {
		int	  h = i / u_head_dim;
		float t = g[i] + dt_bias[i];
		if (u_use_lower_bound != 0) {
			g[i] = u_lower_bound * sigmoidf(-(t * ssm_a[h]));
		} else {
			float sp = t > 20.0 ? t : log(1.0 + exp(t));
			g[i]	 = sp * ssm_a[h];
		}
		return;
	}
	int h = i - u_inner;
	if (h < u_n_heads)
		beta[h] = sigmoidf(beta[h]);
}

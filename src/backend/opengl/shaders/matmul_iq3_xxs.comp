#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer WBuf {
	uint w[];
};
layout(std430, binding = 1) readonly buffer XQBuf {
	uint xq[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};
layout(std430, binding = 4) readonly buffer GridBuf {
	uint grid[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k_blocks;
layout(location = 2) uniform int u_add_residual;
layout(location = 9) uniform int u_m;
layout(location = 10) uniform int u_x_stride;
layout(location = 11) uniform int u_wg_base;

uint g_mi;

#define ROWS 32
#define IQ3XXS_BASE 2560u
#define KSIGNS_BASE 2816u

float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}

uint rb(uint off) {
	uint wd = w[off >> 2u];
	return (wd >> ((off & 3u) * 8u)) & 0xFFu;
}

int xq8(uint bb, int e) {
	return bitfieldExtract(int(xq[bb + uint(e >> 2)]), (e & 3) * 8, 8);
}

uint ksign(uint idx) {
	uint wd = grid[KSIGNS_BASE + (idx >> 2u)];
	return (wd >> ((idx & 3u) * 8u)) & 0xFFu;
}

void store_row(uint idx, float acc) {
	if (u_add_residual == 1)
		y[g_mi * uint(u_n) + idx] = acc + res[idx];
	else if (u_add_residual == 2)
		y[g_mi * uint(u_n) + idx] += acc;
	else
		y[g_mi * uint(u_n) + idx] = acc;
}

void main(void) {
	uint wgid = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	  = uint(max(u_m, 1));
	g_mi	  = wgid % mb;
	wgid	  = wgid / mb;
	uint row  = wgid * uint(ROWS) + gl_LocalInvocationID.x;
	if (int(row) >= u_n)
		return;
	uint row_bytes = uint(u_k_blocks) * 98u;
	uint rw		   = row * row_bytes;

	float acc = 0.0;
	for (int bi = 0; bi < u_k_blocks; bi++) {
		uint  xbq	 = g_mi * uint(u_x_stride) + uint(bi) * 212u;
		float xd	 = uintBitsToFloat(xq[xbq + 80u]);
		uint  bo	 = uint(bi) * 98u;
		float dw	 = h2f(rb(bo + rw) | (rb(bo + 1u + rw) << 8u));
		float scaled = dw * xd * 0.25;
		int	  total	 = 0;
		for (int ib = 0; ib < 8; ib++) {
			uint qs_ib = bo + 2u + uint(ib) * 8u + rw;
			uint sa	   = bo + 66u + uint(ib) * 4u + rw;
			uint saux  = rb(sa) | (rb(sa + 1u) << 8u) | (rb(sa + 2u) << 16u) | (rb(sa + 3u) << 24u);
			int	 sc	   = 1 + 2 * int(saux >> 28u);
			int	 sum   = 0;
			for (int l = 0; l < 4; l++) {
				uint sb	 = ksign((saux >> uint(l * 7)) & 127u);
				uint gw1 = grid[IQ3XXS_BASE + rb(qs_ib + uint(2 * l))];
				uint gw2 = grid[IQ3XXS_BASE + rb(qs_ib + uint(2 * l + 1))];
				int	 xb	 = ib * 32 + l * 8;
				sum += (((sb & 1u) != 0u ? -int((gw1 >> 0u) & 0xFFu) : int((gw1 >> 0u) & 0xFFu)) *
						xq8(xbq, xb + 0));
				sum += (((sb & 2u) != 0u ? -int((gw1 >> 8u) & 0xFFu) : int((gw1 >> 8u) & 0xFFu)) *
						xq8(xbq, xb + 1));
				sum += (((sb & 4u) != 0u ? -int((gw1 >> 16u) & 0xFFu) : int((gw1 >> 16u) & 0xFFu)) *
						xq8(xbq, xb + 2));
				sum += (((sb & 8u) != 0u ? -int((gw1 >> 24u) & 0xFFu) : int((gw1 >> 24u) & 0xFFu)) *
						xq8(xbq, xb + 3));
				sum += (((sb & 16u) != 0u ? -int((gw2 >> 0u) & 0xFFu) : int((gw2 >> 0u) & 0xFFu)) *
						xq8(xbq, xb + 4));
				sum += (((sb & 32u) != 0u ? -int((gw2 >> 8u) & 0xFFu) : int((gw2 >> 8u) & 0xFFu)) *
						xq8(xbq, xb + 5));
				sum +=
					(((sb & 64u) != 0u ? -int((gw2 >> 16u) & 0xFFu) : int((gw2 >> 16u) & 0xFFu)) *
					 xq8(xbq, xb + 6));
				sum +=
					(((sb & 128u) != 0u ? -int((gw2 >> 24u) & 0xFFu) : int((gw2 >> 24u) & 0xFFu)) *
					 xq8(xbq, xb + 7));
			}
			total += sc * sum;
		}
		acc += scaled * float(total);
	}
	store_row(row, acc);
}

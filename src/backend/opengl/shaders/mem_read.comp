#version 310 es
precision highp float;
layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer SrcBuf {
	uvec4 src[];
};
layout(std430, binding = 1) writeonly buffer DstBuf {
	uint dst[];
};

layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_groups;

shared uint partial[128];

void main(void) {
	uint g	 = gl_WorkGroupID.x;
	uint lid = gl_LocalInvocationID.x;

	uint per   = (uint(u_n) + uint(u_groups) - 1u) / uint(u_groups);
	uint start = g * per;
	uint end   = min(start + per, uint(u_n));

	uint acc = 0u;
	for (uint i = start + lid; i < end; i += 128u) {
		uvec4 v = src[i];
		acc ^= v.x ^ v.y ^ v.z ^ v.w;
	}

	partial[lid] = acc;
	barrier();
	for (uint s = 64u; s > 0u; s >>= 1u) {
		if (lid < s)
			partial[lid] ^= partial[lid + s];
		barrier();
	}
	if (lid == 0u)
		dst[g] = partial[0];
}

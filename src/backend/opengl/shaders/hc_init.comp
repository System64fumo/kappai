#version 310 es
precision highp float;
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer XBuf {
	float x[];
};
layout(std430, binding = 1) writeonly buffer HcBuf {
	float hc[];
};
layout(location = 0) uniform int u_dim;
layout(location = 1) uniform int u_total;

void main(void) {
	int i = int(gl_GlobalInvocationID.x);
	if (i >= u_total)
		return;
	hc[i] = x[i % u_dim];
}

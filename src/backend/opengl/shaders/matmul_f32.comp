#version 310 es
#include "activate.glsl"
precision highp float;

#ifndef MT
#define MT 1
#endif
#if MT == 1
#define KB 6
#define WG 64
#else
#define KB 1
#define WG 32
#endif
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer WBuf {
	vec4 w[];
};
layout(std430, binding = 1) readonly buffer XBuf {
	vec4 x[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k;
layout(location = 2) uniform int u_add_residual;
layout(location = 9) uniform int u_m;
layout(location = 10) uniform int u_x_stride;
layout(location = 11) uniform int u_wg_base;
#ifdef FUSED_ACT
layout(std430, binding = 4) readonly buffer UpBuf {
	vec4 up[];
};
layout(location = 12) uniform int u_act;

float act1(float g) {
	return u_act == 1 ? gelu_tanh(g) : silu(g);
}

vec4 xin(uint i) {
	vec4 g = x[i];
	return vec4(act1(g.x), act1(g.y), act1(g.z), act1(g.w)) * up[i];
}
#else
vec4 xin(uint i) {
	return x[i];
}
#endif

#define ROWS 4

shared float s_acc[ROWS * MT][WG + 1];

void main(void) {
	uint wgid  = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	   = uint(max(u_m, 1));
	uint mt	   = (mb + uint(MT) - 1u) / uint(MT);
	uint col0  = (wgid % mt) * uint(MT);
	uint ncols = min(uint(MT), mb - col0);
	uint row0  = (wgid / mt) * uint(ROWS);
	uint tid   = gl_LocalInvocationID.x;
	uint last  = uint(max(u_n - 1, 0));
	uint k4	   = uint(u_k >> 2);

	uint wrow[ROWS];
	uint xrow[MT];
	vec4 acc[ROWS * MT];
	for (int r = 0; r < ROWS; r++)
		wrow[r] = min(row0 + uint(r), last) * k4;
	for (int c = 0; c < MT; c++)
		xrow[c] = min(col0 + uint(c), mb - 1u) * k4;
	for (int i = 0; i < ROWS * MT; i++)
		acc[i] = vec4(0.0);

	for (uint k0 = tid; k0 < k4; k0 += uint(WG * KB)) {
		vec4 xv[KB * MT];
		vec4 wv[KB * ROWS];
		for (int b = 0; b < KB; b++) {
			uint k	 = k0 + uint(b * WG);
			bool act = k < k4;
			for (int c = 0; c < MT; c++)
				xv[b * MT + c] = act ? xin(xrow[c] + k) : vec4(0.0);
			for (int r = 0; r < ROWS; r++)
				wv[b * ROWS + r] = act ? w[wrow[r] + k] : vec4(0.0);
		}
		for (int b = 0; b < KB; b++)
			for (int r = 0; r < ROWS; r++)
				for (int c = 0; c < MT; c++)
					acc[r * MT + c] += wv[b * ROWS + r] * xv[b * MT + c];
	}
	for (int i = 0; i < ROWS * MT; i++)
		s_acc[i][tid] = acc[i].x + acc[i].y + acc[i].z + acc[i].w;
	barrier();
	for (uint i = tid; i < uint(ROWS * MT); i += uint(WG)) {
		uint r	 = i / uint(MT);
		uint c	 = i % uint(MT);
		uint row = row0 + r;
		if (int(row) >= u_n || c >= ncols)
			continue;
		float v = 0.0;
		for (int j = 0; j < WG; j++)
			v += s_acc[i][j];
		uint yi = (col0 + c) * uint(u_n) + row;
		if (u_add_residual == 1)
			y[yi] = v + res[row];
		else if (u_add_residual == 2)
			y[yi] += v;
		else
			y[yi] = v;
	}
}

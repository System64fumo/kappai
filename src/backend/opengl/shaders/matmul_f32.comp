#version 310 es
precision highp float;

#ifndef WG
#define WG 32
#endif
#ifndef MT
#define MT 1
#endif
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer WBuf {
	vec4 w[];
};
layout(std430, binding = 1) readonly buffer XBuf {
	vec4 x[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k;
layout(location = 2) uniform int u_add_residual;
layout(location = 9) uniform int u_m;
layout(location = 10) uniform int u_x_stride;
layout(location = 11) uniform int u_wg_base;

#define ROWS 4

shared float s_acc[ROWS * MT][WG + 1];

void main(void) {
	uint wgid  = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	   = uint(max(u_m, 1));
	uint mt	   = (mb + uint(MT) - 1u) / uint(MT);
	uint col0  = (wgid % mt) * uint(MT);
	uint ncols = min(uint(MT), mb - col0);
	uint row0  = (wgid / mt) * uint(ROWS);
	uint tid   = gl_LocalInvocationID.x;
	uint last  = uint(max(u_n - 1, 0));
	uint k4	   = uint(u_k >> 2);

	uint wrow[ROWS];
	uint xrow[MT];
	vec4 acc[ROWS * MT];
	for (int r = 0; r < ROWS; r++)
		wrow[r] = min(row0 + uint(r), last) * k4;
	for (int c = 0; c < MT; c++)
		xrow[c] = min(col0 + uint(c), mb - 1u) * k4;
	for (int i = 0; i < ROWS * MT; i++)
		acc[i] = vec4(0.0);

	for (uint k = tid; k < k4; k += uint(WG)) {
		vec4 xv[MT];
		for (int c = 0; c < MT; c++)
			xv[c] = x[xrow[c] + k];
		for (int r = 0; r < ROWS; r++) {
			vec4 wv = w[wrow[r] + k];
			for (int c = 0; c < MT; c++)
				acc[r * MT + c] += wv * xv[c];
		}
	}
	for (int i = 0; i < ROWS * MT; i++)
		s_acc[i][tid] = acc[i].x + acc[i].y + acc[i].z + acc[i].w;
	barrier();
	for (uint i = tid; i < uint(ROWS * MT); i += uint(WG)) {
		uint r	 = i / uint(MT);
		uint c	 = i % uint(MT);
		uint row = row0 + r;
		if (int(row) >= u_n || c >= ncols)
			continue;
		float v = 0.0;
		for (int j = 0; j < WG; j++)
			v += s_acc[i][j];
		uint yi = (col0 + c) * uint(u_n) + row;
		if (u_add_residual == 1)
			y[yi] = v + res[row];
		else if (u_add_residual == 2)
			y[yi] += v;
		else
			y[yi] = v;
	}
}

#version 310 es
precision highp float;
precision highp int;

#ifndef WG
#define WG 32
#endif
#ifndef MT
#define MT 1
#endif
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer WBuf {
	uint w[];
};
layout(std430, binding = 1) readonly buffer XBuf {
	float x[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};

layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k;
layout(location = 2) uniform int u_add_residual;
layout(location = 9) uniform int u_m;
layout(location = 10) uniform int u_x_stride;
layout(location = 11) uniform int u_wg_base;

#define ROWS 4

shared float s_acc[ROWS * MT][WG + 1];

#ifndef BF16
float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}
#endif

void main(void) {
	uint wgid  = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	   = uint(max(u_m, 1));
	uint mt	   = (mb + uint(MT) - 1u) / uint(MT);
	uint col0  = (wgid % mt) * uint(MT);
	uint ncols = min(uint(MT), mb - col0);
	uint row0  = (wgid / mt) * uint(ROWS);
	uint tid   = gl_LocalInvocationID.x;
	uint last  = uint(max(u_n - 1, 0));

	uint  rows[ROWS];
	uint  xrow[MT];
	float acc[ROWS * MT];
	for (int r = 0; r < ROWS; r++)
		rows[r] = min(row0 + uint(r), last) * uint(u_k);
	for (int c = 0; c < MT; c++)
		xrow[c] = min(col0 + uint(c), mb - 1u) * uint(u_k);
	for (int i = 0; i < ROWS * MT; i++)
		acc[i] = 0.0;

	if ((u_k & 1) == 0) {
		for (uint kp = tid; kp < uint(u_k >> 1); kp += uint(WG)) {
			vec2 xv[MT];
			for (int c = 0; c < MT; c++)
				xv[c] = vec2(x[xrow[c] + 2u * kp], x[xrow[c] + 2u * kp + 1u]);
			for (int r = 0; r < ROWS; r++) {
				uint wd = w[(rows[r] >> 1u) + kp];
#ifdef BF16
				vec2 hv = vec2(uintBitsToFloat(wd << 16u), uintBitsToFloat(wd & 0xFFFF0000u));
#else
				vec2 hv = unpackHalf2x16(wd);
#endif
				for (int c = 0; c < MT; c++)
					acc[r * MT + c] += hv.x * xv[c].x + hv.y * xv[c].y;
			}
		}
	} else {
		for (int ki = int(tid); ki < u_k; ki += WG) {
			for (int r = 0; r < ROWS; r++) {
				uint e	= rows[r] + uint(ki);
				uint wd = w[e >> 1u];
				uint h	= (e & 1u) == 0u ? (wd & 0xFFFFu) : (wd >> 16u);
#ifdef BF16
				float wf = uintBitsToFloat(h << 16u);
#else
				float wf = h2f(h);
#endif
				for (int c = 0; c < MT; c++)
					acc[r * MT + c] += wf * x[xrow[c] + uint(ki)];
			}
		}
	}
	for (int i = 0; i < ROWS * MT; i++)
		s_acc[i][tid] = acc[i];
	barrier();
	for (uint i = tid; i < uint(ROWS * MT); i += uint(WG)) {
		uint r	 = i / uint(MT);
		uint c	 = i % uint(MT);
		uint row = row0 + r;
		if (int(row) >= u_n || c >= ncols)
			continue;
		float v = 0.0;
		for (int j = 0; j < WG; j++)
			v += s_acc[i][j];
		uint yi = (col0 + c) * uint(u_n) + row;
		if (u_add_residual == 1)
			y[yi] = v + res[row];
		else if (u_add_residual == 2)
			y[yi] += v;
		else
			y[yi] = v;
	}
}

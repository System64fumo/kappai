#version 310 es
precision highp float;
precision highp int;

#ifndef WG
#define WG 32
#endif
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer WBuf {
	uint w[];
};
layout(std430, binding = 1) readonly buffer XBuf {
	float x[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};

layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k;
layout(location = 2) uniform int u_add_residual;
layout(location = 9) uniform int u_m;
layout(location = 10) uniform int u_x_stride;
layout(location = 11) uniform int u_wg_base;

uint g_mi;

#define ROWS 4

shared float s_acc[ROWS][WG];

float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}

void main(void) {
	uint wgid = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	  = uint(max(u_m, 1));
	g_mi	  = wgid % mb;
	wgid	  = wgid / mb;
	uint row0 = wgid * uint(ROWS);
	uint tid  = gl_LocalInvocationID.x;
	uint last = uint(max(u_n - 1, 0));
	uint xrow = g_mi * uint(u_k);

	uint  rows[ROWS];
	float acc[ROWS];
	for (int r = 0; r < ROWS; r++) {
		rows[r] = min(row0 + uint(r), last);
		acc[r]	= 0.0;
	}
	if ((u_k & 1) == 0) {
		uint wb[ROWS];
		for (int r = 0; r < ROWS; r++)
			wb[r] = (rows[r] * uint(u_k)) >> 1u;
		for (uint kp = tid; kp < uint(u_k >> 1); kp += uint(WG)) {
			float x0 = x[xrow + 2u * kp];
			float x1 = x[xrow + 2u * kp + 1u];
			for (int r = 0; r < ROWS; r++) {
				vec2 hv = unpackHalf2x16(w[wb[r] + kp]);
				acc[r] += hv.x * x0 + hv.y * x1;
			}
		}
	} else {
		for (int ki = int(tid); ki < u_k; ki += WG) {
			float xv = x[xrow + uint(ki)];
			for (int r = 0; r < ROWS; r++) {
				uint e	= rows[r] * uint(u_k) + uint(ki);
				uint wd = w[e >> 1u];
				uint h	= (e & 1u) == 0u ? (wd & 0xFFFFu) : (wd >> 16u);
				acc[r] += h2f(h) * xv;
			}
		}
	}
	for (int r = 0; r < ROWS; r++)
		s_acc[r][tid] = acc[r];
	barrier();
	for (uint s = uint(WG) / 2u; s > 0u; s >>= 1u) {
		if (tid < s)
			for (int r = 0; r < ROWS; r++)
				s_acc[r][tid] += s_acc[r][tid + s];
		barrier();
	}
	if (tid < uint(ROWS)) {
		uint row = row0 + tid;
		if (int(row) < u_n) {
			float v = s_acc[tid][0];
			if (u_add_residual == 1)
				y[g_mi * uint(u_n) + row] = v + res[row];
			else if (u_add_residual == 2)
				y[g_mi * uint(u_n) + row] += v;
			else
				y[g_mi * uint(u_n) + row] = v;
		}
	}
}

#version 310 es
#include "activate.glsl"
precision highp float;
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer FusedBuf {
	float fused[];
};
layout(std430, binding = 1) writeonly buffer OutBuf {
	float out_[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_m;
layout(location = 2) uniform int u_act;
void main(void) {
	uint wgx = gl_WorkGroupID.x + gl_WorkGroupID.y * 65535u;
	uint g	 = wgx * 128u + gl_LocalInvocationID.x;
	if (g >= uint(u_n) * uint(u_m))
		return;
	int	  row = int(g) / u_n;
	int	  col = int(g) - row * u_n;
	int	  gi  = row * 2 * u_n + col;
	float gv  = fused[gi];
	float u	  = fused[gi + u_n];
	float act;
	if (u_act == 1) {
		act = gelu_tanh(gv);
	} else {
		act = silu(gv);
	}
	out_[row * u_n + col] = act * u;
}

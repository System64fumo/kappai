#version 310 es
precision highp float;
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer GateBuf {
	float gate[];
};
layout(std430, binding = 1) readonly buffer UpBuf {
	float up[];
};
layout(std430, binding = 2) writeonly buffer OutBuf {
	float out_[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_act;
void main(void) {
	uint i = gl_GlobalInvocationID.x;
	if (int(i) >= u_n)
		return;
	float g = gate[i];
	float u = up[i];
	float gv;
	if (u_act == 1) {
		float t = 0.7978845608 * (g + 0.044715 * g * g * g);
		gv		= 0.5 * g * (1.0 + tanh(t));
	} else {
		gv = g / (1.0 + exp(-g));
	}
	out_[i] = gv * u;
}

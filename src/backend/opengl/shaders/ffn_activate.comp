#version 310 es
#include "activate.glsl"
precision highp float;
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer GateBuf {
	float gate[];
};
layout(std430, binding = 1) readonly buffer UpBuf {
	float up[];
};
layout(std430, binding = 2) writeonly buffer OutBuf {
	float out_[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_act;
layout(location = 2) uniform float u_gs;
layout(location = 3) uniform float u_us;
void main(void) {
	uint i = gl_WorkGroupID.x * 128u + gl_LocalInvocationID.x + gl_WorkGroupID.y * 65535u * 128u;
	if (int(i) >= u_n)
		return;
	float g = gate[i] * u_gs;
	float u = up[i] * u_us;
	float gv;
	gv		= u_act == 1 ? gelu_tanh(g) : silu(g);
	out_[i] = gv * u;
}

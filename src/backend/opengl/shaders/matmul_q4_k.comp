#version 310 es
precision highp float;
precision highp int;

#ifndef WG
#define WG 32
#endif
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer WBuf {
	uvec4 w[];
};
layout(std430, binding = 1) readonly buffer XQBuf {
	uvec4 xq4[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k_blocks;
layout(location = 2) uniform int u_add_residual;
layout(location = 9) uniform int u_m;
layout(location = 10) uniform int u_x_stride;
layout(location = 11) uniform int u_wg_base;

uint g_mi;

#define ROWS 4
#define NIB 0x000F000Fu
#ifdef Q5K
#define HBIT 0x00100010u
#define QB 44u
#define QBOFF 12u
#define REPACKED_BLOCK_BYTES 360u
#define REPACKED_DATA_OFFSET 104u
#else
#define QB 36u
#define QBOFF 4u
#define REPACKED_BLOCK_BYTES 296u
#define REPACKED_DATA_OFFSET 40u
#endif

shared float s_acc[ROWS][WG + 1];

float reduce_row(uint i) {
	float v = 0.0;
	for (int j = 0; j < WG; j++)
		v += s_acc[i][j];
	return v;
}

uint wu(uint i) {
	return w[i >> 2u][i & 3u];
}

float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}

int pair_field_sum(uint acc) {
	uint low = uint(bitfieldExtract(int(acc), 0, 16));
	return int(acc - low) >> 16;
}

void scale_min(uvec3 sw, int j, out uint sc, out uint mn) {
	if (j < 4) {
		uint sh = uint(j) * 8u;
		sc		= (sw.x >> sh) & 63u;
		mn		= (sw.y >> sh) & 63u;
		return;
	}
	uint sh = uint(j - 4) * 8u;
	uint hi = sw.z >> sh;
	sc		= (hi & 0xFu) | (((sw.x >> sh) >> 6u & 3u) << 4u);
	mn		= ((hi >> 4u) & 0xFu) | (((sw.y >> sh) >> 6u & 3u) << 4u);
}

#ifdef REPACKED
uint qs_base(uint rowg, int bi, int g) {
	return (rowg >> 3u) * uint(u_k_blocks) * REPACKED_BLOCK_BYTES +
		   uint(bi) * REPACKED_BLOCK_BYTES + REPACKED_DATA_OFFSET + (rowg & 7u) * 32u +
		   uint(g) * 8u;
}

#ifdef Q5K
uint qh_base(uint rowg, int bi) {
	return (rowg >> 3u) * uint(u_k_blocks) * REPACKED_BLOCK_BYTES +
		   uint(bi) * REPACKED_BLOCK_BYTES + 40u + (rowg & 7u) * 8u;
}
#endif

void row_header(uint rowg, int bi, int g, out float d, out float dm, out uint sc0, out uint mn0,
				out uint sc1, out uint mn1) {
	uint gw =
		(rowg >> 3u) * uint(u_k_blocks) * REPACKED_BLOCK_BYTES + uint(bi) * REPACKED_BLOCK_BYTES;
	uint rin = rowg & 7u;
	uint dw	 = wu(gw + (rin >> 1u));
	uint mw	 = wu(gw + 4u + (rin >> 1u));
	d		 = h2f((rin & 1u) != 0u ? dw >> 16u : dw);
	dm		 = h2f((rin & 1u) != 0u ? mw >> 16u : mw);
	uint sw	 = wu(gw + 8u + rin * 4u + uint(g));
	sc0		 = sw & 0xFFu;
	mn0		 = (sw >> 8u) & 0xFFu;
	sc1		 = (sw >> 16u) & 0xFFu;
	mn1		 = sw >> 24u;
}
#else
uint qs_base(uint rowg, int bi, int g) {
	return (rowg * uint(u_k_blocks) + uint(bi)) * QB + QBOFF + uint(g) * 8u;
}

#ifdef Q5K
uint qh_base(uint rowg, int bi) {
	return (rowg * uint(u_k_blocks) + uint(bi)) * QB + 4u;
}
#endif

void row_header(uint rowg, int bi, int g, out float d, out float dm, out uint sc0, out uint mn0,
				out uint sc1, out uint mn1) {
	uint  bw = (rowg * uint(u_k_blocks) + uint(bi)) * QB;
	uint  hw = wu(bw);
	uvec3 sw = uvec3(w[(bw >> 2u)].yzw);
	d		 = h2f(hw);
	dm		 = h2f(hw >> 16u);
	scale_min(sw, 2 * g, sc0, mn0);
	scale_min(sw, 2 * g + 1, sc1, mn1);
}
#endif

void main(void) {
	uint wgid = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	  = uint(max(u_m, 1));
	g_mi	  = wgid % mb;
	wgid	  = wgid / mb;
	uint row0 = wgid * uint(ROWS);
	uint tid  = gl_LocalInvocationID.x;
	uint last = uint(max(u_n - 1, 0));

	float acc[ROWS];
	for (int r = 0; r < ROWS; r++)
		acc[r] = 0.0;
	int nch	  = u_k_blocks * 4;
	int iters = (nch + WG - 1) / WG;
	for (int it = 0; it < iters; it++) {
		int c  = it * WG + int(tid);
		int bi = c >> 2;
		int g  = c & 3;
		if (c >= nch)
			continue;
		uint  xbq = (g_mi * uint(u_x_stride) + uint(bi) * 212u) >> 2u;
		float xd  = uintBitsToFloat(xq4[xbq + 20u].x);
		if (xd == 0.0)
			continue;
		uint  xp	= xbq + 21u + uint(g) * 8u;
		uvec4 sx	= xq4[xbq + 16u + uint(g)];
		int	  sx_lo = int(sx.x) + int(sx.y);
		int	  sx_hi = int(sx.z) + int(sx.w);
		uvec4 xv[8];
		for (int j = 0; j < 8; j++)
			xv[j] = xq4[xp + uint(j)];

#ifdef Q5K
		uint  sh_lo_l = uint(max(4 - 2 * g, 0));
		uint  sh_lo_r = uint(max(2 * g - 4, 0));
		uint  sh_hi_l = uint(max(3 - 2 * g, 0));
		uint  sh_hi_r = uint(max(2 * g - 3, 0));
		uint  sh_b_lo = uint(2 * g + 4);
		uint  sh_b_hi = uint(2 * g + 5);
		uint  qbase[ROWS];
		uint  hbase[ROWS];
		int	  dot0[ROWS];
		int	  dot1[ROWS];
		uvec4 wq[ROWS][2];
		for (int r = 0; r < ROWS; r++) {
			qbase[r] = qs_base(min(row0 + uint(r), last), bi, g);
			wq[r][0] = w[qbase[r] >> 2u];
			wq[r][1] = w[(qbase[r] >> 2u) + 1u];
			hbase[r] = qh_base(min(row0 + uint(r), last), bi);
			dot0[r]	 = 0;
			dot1[r]	 = 0;
		}
		for (int half_i = 0; half_i < 4; half_i++) {
			uint la[ROWS];
			uint ha[ROWS];
			for (int r = 0; r < ROWS; r++) {
				la[r] = 0u;
				ha[r] = 0u;
			}
			for (int i = half_i * 2; i < half_i * 2 + 2; i++) {
				uint xa0 = xv[i >> 1][(i & 1) * 2];
				uint xa1 = xv[i >> 1][(i & 1) * 2 + 1];
				uint xb0 = xv[4 + (i >> 1)][(i & 1) * 2];
				uint xb1 = xv[4 + (i >> 1)][(i & 1) * 2 + 1];
				for (int r = 0; r < ROWS; r++) {
					uint qw = wq[r][i >> 2][i & 3];
					uint hq = wu(hbase[r] + uint(i));
					uint h0 = (g < 2 ? (hq << sh_lo_l) : (hq >> sh_lo_r)) & HBIT;
					uint h1 = (hq >> (sh_b_lo)) & HBIT;
					uint h2 = (g < 2 ? (hq << sh_hi_l) : (hq >> sh_hi_r)) & HBIT;
					uint h3 = (hq >> (sh_b_hi)) & HBIT;
					la[r] += ((qw & NIB) | h0) * xa0 + (((qw >> 8u) & NIB) | h1) * xa1;
					ha[r] += (((qw >> 4u) & NIB) | h2) * xb0 + (((qw >> 12u) & NIB) | h3) * xb1;
				}
			}
			for (int r = 0; r < ROWS; r++) {
				dot0[r] += pair_field_sum(la[r]);
				dot1[r] += pair_field_sum(ha[r]);
			}
		}
#else
		uint  qbase[ROWS];
		int	  dot0[ROWS];
		int	  dot1[ROWS];
		uvec4 wq[ROWS][2];
		for (int r = 0; r < ROWS; r++) {
			qbase[r] = qs_base(min(row0 + uint(r), last), bi, g);
			wq[r][0] = w[qbase[r] >> 2u];
			wq[r][1] = w[(qbase[r] >> 2u) + 1u];
			dot0[r]	 = 0;
			dot1[r]	 = 0;
		}
		for (int half_i = 0; half_i < 2; half_i++) {
			uint la[ROWS];
			uint ha[ROWS];
			for (int r = 0; r < ROWS; r++) {
				la[r] = 0u;
				ha[r] = 0u;
			}
			for (int i = half_i * 4; i < half_i * 4 + 4; i++) {
				uint xa0 = xv[i >> 1][(i & 1) * 2];
				uint xa1 = xv[i >> 1][(i & 1) * 2 + 1];
				uint xb0 = xv[4 + (i >> 1)][(i & 1) * 2];
				uint xb1 = xv[4 + (i >> 1)][(i & 1) * 2 + 1];
				for (int r = 0; r < ROWS; r++) {
					uint qw = wq[r][i >> 2][i & 3];
					la[r] += (qw & NIB) * xa0 + ((qw >> 8u) & NIB) * xa1;
					ha[r] += ((qw >> 4u) & NIB) * xb0 + ((qw >> 12u) & NIB) * xb1;
				}
			}
			for (int r = 0; r < ROWS; r++) {
				dot0[r] += pair_field_sum(la[r]);
				dot1[r] += pair_field_sum(ha[r]);
			}
		}
#endif
		for (int r = 0; r < ROWS; r++) {
			float d, dm;
			uint  sc0, mn0, sc1, mn1;
			row_header(min(row0 + uint(r), last), bi, g, d, dm, sc0, mn0, sc1, mn1);
			int sumi = int(sc0) * dot0[r] + int(sc1) * dot1[r];
			int summ = int(mn0) * sx_lo + int(mn1) * sx_hi;
			acc[r] += xd * (d * float(sumi) - dm * float(summ));
		}
	}
	for (int r = 0; r < ROWS; r++)
		s_acc[r][tid] = acc[r];
	barrier();
	if (tid < uint(ROWS)) {
		uint row = row0 + tid;
		if (int(row) < u_n) {
			float v = reduce_row(tid);
			if (u_add_residual == 1)
				y[g_mi * uint(u_n) + row] = v + res[row];
			else if (u_add_residual == 2)
				y[g_mi * uint(u_n) + row] += v;
			else
				y[g_mi * uint(u_n) + row] = v;
		}
	}
}

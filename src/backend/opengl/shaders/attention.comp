#version 310 es
precision highp float;
precision highp int;
#ifndef ATTN_WG
#define ATTN_WG 64
#endif
#define LANES 16
#define PASS_TOKENS (ATTN_WG / LANES)
#define MAX_HEAD_DIM 512
#define MAX_PAIR_SLOTS (MAX_HEAD_DIM / 2 / ATTN_WG)
layout(local_size_x = ATTN_WG) in;
layout(std430, binding = 0) readonly buffer QBuf {
	float q[];
};
layout(std430, binding = 1) readonly buffer KBuf {
	uint kcache[];
};
layout(std430, binding = 2) readonly buffer VBuf {
	uint vcache[];
};
layout(std430, binding = 3) writeonly buffer PartBuf {
	float part[];
};
layout(std430, binding = 4) buffer OutBuf {
	float out_[];
};
layout(location = 0) uniform int u_layer_off;
layout(location = 1) uniform int u_pos;
layout(location = 2) uniform int u_n_heads;
layout(location = 3) uniform int u_n_kv_heads;
layout(location = 4) uniform int u_head_dim;
layout(location = 5) uniform int u_n_ctx;
layout(location = 6) uniform float u_scale;
layout(location = 7) uniform int u_stride_head_dim;
layout(location = 8) uniform int u_attn_start;
layout(location = 9) uniform int u_kv_q8;
layout(location = 10) uniform int u_kvh_stride;
layout(location = 11) uniform int u_chunk;
layout(location = 12) uniform int u_n_splits;
shared vec2	 q2[MAX_HEAD_DIM / 2];
shared float partial[ATTN_WG * LANES];
shared float e_tile[ATTN_WG];
shared float s_tile[ATTN_WG];
shared float m_part[ATTN_WG / 4];
shared vec2	 red[ATTN_WG];
shared float l_red[ATTN_WG];

uint ld16k(uint byte_off) {
	return (kcache[byte_off >> 2u] >> ((byte_off & 2u) * 8u)) & 0xFFFFu;
}

uint ld16v(uint byte_off) {
	return (vcache[byte_off >> 2u] >> ((byte_off & 2u) * 8u)) & 0xFFFFu;
}

float k_partial(uint row, int lane, int pairs) {
	float a = 0.0;
	if (u_kv_q8 == 0) {
		uint wb = row >> 1u;
		for (int p = lane; p < pairs; p += LANES)
			a += dot(unpackHalf2x16(kcache[wb + uint(p)]), q2[p]);
		return a;
	}
	for (int p = lane; p < pairs; p += LANES) {
		uint  boff = row + uint(p >> 4) * 34u;
		float d	   = unpackHalf2x16(ld16k(boff)).x;
		int	  hv   = int(ld16k(boff + 2u + uint((p & 15) * 2)));
		vec2  qq   = q2[p];
		a +=
			d * (qq.x * float(bitfieldExtract(hv, 0, 8)) + qq.y * float(bitfieldExtract(hv, 8, 8)));
	}
	return a;
}

vec2 v_pair(uint row, int p) {
	if (u_kv_q8 == 0)
		return unpackHalf2x16(vcache[(row >> 1u) + uint(p)]);
	uint  boff = row + uint(p >> 4) * 34u;
	float d	   = unpackHalf2x16(ld16v(boff)).x;
	int	  hv   = int(ld16v(boff + 2u + uint((p & 15) * 2)));
	return d * vec2(float(bitfieldExtract(hv, 0, 8)), float(bitfieldExtract(hv, 8, 8)));
}

void main(void) {
	uint h		  = gl_WorkGroupID.x;
	int	 split	  = int(gl_WorkGroupID.y);
	uint tid	  = gl_LocalInvocationID.x;
	int	 n_groups = u_n_heads / u_n_kv_heads;
	int	 kvh	  = int(h) / n_groups;
	int	 head_dim = u_head_dim;
	int	 pairs	  = head_dim >> 1;
	int	 t_begin  = u_attn_start + split * u_chunk;
	int	 t_end	  = min(u_pos + 1, t_begin + u_chunk);
	uint q_base	  = h * uint(head_dim);

	for (int p = int(tid); p < pairs; p += ATTN_WG)
		q2[p] = vec2(q[q_base + uint(p * 2)], q[q_base + uint(p * 2) + 1u]);
	barrier();

	uint kvh_stride =
		u_kvh_stride > 0 ? uint(u_kvh_stride) : uint(u_n_ctx) * uint(u_stride_head_dim);
	uint kv_base	= uint(u_layer_off) + uint(kvh) * kvh_stride;
	uint row_stride = uint(u_stride_head_dim);

	int	 split_groups = pairs > ATTN_WG / 2 ? 1 : ATTN_WG / pairs;
	int	 slot_group	  = split_groups == 1 ? 0 : int(tid) / pairs;
	int	 slot_pair	  = split_groups == 1 ? int(tid) : int(tid) % pairs;
	bool v_active	  = split_groups == 1 || int(tid) < split_groups * pairs;
	int	 lane		  = int(tid) % LANES;
	int	 tok_in_pass  = int(tid) / LANES;

	vec2 o_acc[MAX_PAIR_SLOTS];
	for (int j = 0; j < MAX_PAIR_SLOTS; j++)
		o_acc[j] = vec2(0.0);

	float neg_inf = uintBitsToFloat(0xFF800000u);
	float m_run	  = neg_inf;
	float l_part  = 0.0;

	for (int t0 = t_begin; t0 < t_end; t0 += ATTN_WG) {
		int len = min(ATTN_WG, t_end - t0);
		for (int base = 0; base < len; base += PASS_TOKENS) {
			int	  tl = base + tok_in_pass;
			float a	 = 0.0;
			if (t0 + tl < t_end)
				a = k_partial(kv_base + uint(t0 + tl) * row_stride, lane, pairs);
			partial[tl * LANES + lane] = a;
		}
		barrier();

		int	  tok	= t0 + int(tid);
		float score = neg_inf;
		if (tok < t_end) {
			float s = 0.0;
			for (int l = 0; l < LANES; l++)
				s += partial[int(tid) * LANES + l];
			score = s * u_scale;
		}
		s_tile[tid] = score;
		barrier();

		if (tid < uint(ATTN_WG / 4)) {
			uint b		= tid * 4u;
			m_part[tid] = max(max(s_tile[b], s_tile[b + 1u]), max(s_tile[b + 2u], s_tile[b + 3u]));
		}
		barrier();
		float m_tile = neg_inf;
		for (int t = 0; t < ATTN_WG / 4; t++)
			m_tile = max(m_tile, m_part[t]);
		float m_new = max(m_run, m_tile);
		e_tile[tid] = tok < t_end ? exp(score - m_new) : 0.0;
		float alpha = (m_new == m_run) ? 1.0 : exp(m_run - m_new);
		m_run		= m_new;
		barrier();

		l_part *= alpha;
		if (v_active) {
			for (int j = 0; j < MAX_PAIR_SLOTS; j++)
				o_acc[j] *= alpha;
			for (int t = slot_group; t < len; t += split_groups) {
				float e	  = e_tile[t];
				uint  row = kv_base + uint(t0 + t) * row_stride;
				for (int j = 0; j < MAX_PAIR_SLOTS; j++) {
					int p = slot_pair + j * ATTN_WG;
					if (p >= pairs)
						break;
					o_acc[j] += e * v_pair(row, p);
				}
				l_part += e;
			}
		}
		barrier();
	}

	uint pbase	   = (h * uint(u_n_splits) + uint(split)) * uint(head_dim + 2);
	bool final_out = u_n_splits == 1;
	if (split_groups > 1) {
		red[tid]   = o_acc[0];
		l_red[tid] = l_part;
		barrier();
		if (v_active && slot_group == 0) {
			vec2  o = o_acc[0];
			float l = l_part;
			for (int g = 1; g < split_groups; g++) {
				o += red[g * pairs + slot_pair];
				l += l_red[g * pairs + slot_pair];
			}
			if (final_out) {
				float inv_l	  = l > 0.0 ? 1.0 / l : 0.0;
				uint  ob	  = h * uint(head_dim) + uint(slot_pair * 2);
				out_[ob]	  = o.x * inv_l;
				out_[ob + 1u] = o.y * inv_l;
			} else {
				uint ob		  = pbase + 2u + uint(slot_pair * 2);
				part[ob]	  = o.x;
				part[ob + 1u] = o.y;
				if (slot_pair == 0) {
					part[pbase]		 = m_run;
					part[pbase + 1u] = l;
				}
			}
		}
		return;
	}
	float inv_l = l_part > 0.0 ? 1.0 / l_part : 0.0;
	if (!final_out && tid == 0u) {
		part[pbase]		 = m_run;
		part[pbase + 1u] = l_part;
	}
	for (int j = 0; j < MAX_PAIR_SLOTS; j++) {
		int p = int(tid) + j * ATTN_WG;
		if (p >= pairs)
			break;
		if (final_out) {
			uint ob		  = h * uint(head_dim) + uint(p * 2);
			out_[ob]	  = o_acc[j].x * inv_l;
			out_[ob + 1u] = o_acc[j].y * inv_l;
		} else {
			uint ob		  = pbase + 2u + uint(p * 2);
			part[ob]	  = o_acc[j].x;
			part[ob + 1u] = o_acc[j].y;
		}
	}
}

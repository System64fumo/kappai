#version 310 es
precision highp float;
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer DstBuf {
	float dst[];
};
layout(std430, binding = 1) readonly buffer Src1Buf {
	float src1[];
};
layout(std430, binding = 2) buffer Src2Buf {
	float src2[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_mode;
layout(location = 2) uniform float u_scale;
layout(location = 3) uniform int u_aux;
layout(location = 4) uniform int u_m;
void main(void) {
	uint row = gl_WorkGroupID.y + 65535u * gl_WorkGroupID.z;
	if (row >= uint(u_m))
		return;
	uint row_off = row * uint(u_n);
	uint i		 = gl_GlobalInvocationID.x;
	if (int(i) >= u_n)
		return;
	if (u_mode == 1) {
		dst[row_off + i] = dst[row_off + i] + src1[row_off + i];
	} else if (u_mode == 2) {
		dst[row_off + i] = dst[row_off + i] * u_scale;
	} else if (u_mode == 4) {
		dst[row_off + i] = u_scale * tanh(dst[row_off + i] / u_scale);
	} else if (u_mode == 5) {
		uint head_dim_v = uint(u_aux);
		uint within		= i % head_dim_v;
		uint flat_idx	= row_off + i;
		uint mixed_idx	= 2u * flat_idx - within;
		dst[flat_idx]	= src1[mixed_idx];
		src2[flat_idx]	= src1[mixed_idx + head_dim_v];
	} else if (u_mode == 6) {
		dst[row_off + i] = dst[row_off + i] * (1.0 / (1.0 + exp(-src1[row_off + i])));
	} else if (u_mode == 7) {
		dst[row_off + i] = (dst[row_off + i] + src1[row_off + i]) * u_scale;
	}
}

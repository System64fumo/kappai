#version 310 es
precision highp float;
precision highp int;

#ifndef WG
#define WG 32
#endif

layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer WBuf {
	uint w[];
};
layout(std430, binding = 1) readonly buffer XQBuf {
	uvec4 xq4[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};
layout(std430, binding = 4) readonly buffer LutBuf {
	uint lut[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k_blocks;
layout(location = 2) uniform int u_add_residual;
layout(location = 9) uniform int u_m;
layout(location = 10) uniform int u_x_stride;
layout(location = 11) uniform int u_wg_base;

uint g_mi;

#define ROWS 4

shared float s_acc[ROWS][WG];

float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}

uint sh2(uint a, uint b, uint odd) {
	return odd != 0u ? b : ((a >> 16u) | (b << 16u));
}

int pair_field_sum(uint acc) {
	uint low = uint(bitfieldExtract(int(acc), 0, 16));
	return int(acc - low) >> 16;
}

int dot_word(uint qw, uvec4 yv) {
	return pair_field_sum(lut[qw & 0xFFu] * yv.x) + pair_field_sum(lut[(qw >> 8u) & 0xFFu] * yv.y) +
		   pair_field_sum(lut[(qw >> 16u) & 0xFFu] * yv.z) + pair_field_sum(lut[qw >> 24u] * yv.w);
}

void main(void) {
	uint wgid = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	  = uint(max(u_m, 1));
	g_mi	  = wgid % mb;
	wgid	  = wgid / mb;
	uint row0 = wgid * uint(ROWS);
	uint tid  = gl_LocalInvocationID.x;
	uint last = uint(max(u_n - 1, 0));

	uint  row_off[ROWS];
	float acc[ROWS];
	for (int r = 0; r < ROWS; r++) {
		row_off[r] = min(row0 + uint(r), last) * uint(u_k_blocks) * 18u;
		acc[r]	   = 0.0;
	}
	for (int bi = int(tid); bi < u_k_blocks; bi += WG) {
		uint  xi  = g_mi * uint(u_x_stride) + uint(bi) * 11u;
		float dxq = uintBitsToFloat(xq4[xi + 2u].x);
		uvec4 y0  = xq4[xi + 7u];
		uvec4 y1  = xq4[xi + 8u];
		uvec4 y2  = xq4[xi + 9u];
		uvec4 y3  = xq4[xi + 10u];
		for (int r = 0; r < ROWS; r++) {
			uint  bo   = row_off[r] + uint(bi) * 18u;
			uint  wi   = bo >> 2u;
			uint  odd  = (bo >> 1u) & 1u;
			uint  w0   = w[wi];
			uint  w1   = w[wi + 1u];
			uint  w2   = w[wi + 2u];
			uint  w3   = w[wi + 3u];
			uint  w4   = w[wi + 4u];
			float wd   = h2f(odd != 0u ? w0 >> 16u : w0);
			int	  sumi = dot_word(sh2(w0, w1, odd), y0) + dot_word(sh2(w1, w2, odd), y1) +
						 dot_word(sh2(w2, w3, odd), y2) + dot_word(sh2(w3, w4, odd), y3);
			acc[r] += wd * dxq * float(sumi);
		}
	}
	for (int r = 0; r < ROWS; r++)
		s_acc[r][tid] = acc[r];
	barrier();
	for (uint s = uint(WG) / 2u; s > 0u; s >>= 1u) {
		if (tid < s)
			for (int r = 0; r < ROWS; r++)
				s_acc[r][tid] += s_acc[r][tid + s];
		barrier();
	}
	if (tid < uint(ROWS)) {
		uint row = row0 + tid;
		if (int(row) < u_n) {
			float v = s_acc[tid][0];
			if (u_add_residual == 1)
				y[g_mi * uint(u_n) + row] = v + res[row];
			else if (u_add_residual == 2)
				y[g_mi * uint(u_n) + row] += v;
			else
				y[g_mi * uint(u_n) + row] = v;
		}
	}
}

#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer WBuf {
	uint w[];
};
layout(std430, binding = 1) readonly buffer XBuf {
	float x[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k_blocks;
layout(location = 2) uniform int u_add_residual;

#define ROWS 4
shared float s_acc[ROWS][32];
shared int	 s_iq4nl[16];

const uint IQ4NL_A0 = 0x3F2D1801u;
const uint IQ4NL_A1 = 0x766A5D4Fu;
const uint IQ4NL_A2 = 0xA6998D81u;
const uint IQ4NL_A3 = 0xF1D9C5B5u;

int iq4nl(uint i) {
	return int(s_iq4nl[i & 15u]);
}

float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}

float round_f16(float f) {
	float base = abs(f) * 4.0;
	uint  w	   = floatBitsToUint(f);
	uint  shl1 = w + w;
	uint  sign = w & 0x80000000u;
	uint  bias = shl1 & 0xFF000000u;
	if (bias < 0x71000000u)
		bias = 0x71000000u;
	base		   = uintBitsToFloat((bias >> 1u) + 0x07800000u) + base;
	uint bits	   = floatBitsToUint(base);
	uint exp_bits  = (bits >> 13u) & 0x7C00u;
	uint mant_bits = bits & 0x0FFFu;
	uint hbits	   = (sign >> 16u) | (shl1 > 0xFF000000u ? 0x7E00u : exp_bits + mant_bits);
	return h2f(hbits);
}

uint rb(uint off) {
	uint wd = w[off >> 2u];
	return (wd >> ((off & 3u) * 8u)) & 0xFFu;
}

uint f32_bits(float f) {
	return floatBitsToUint(f);
}
float bits_f32(uint b) {
	return uintBitsToFloat(b);
}

uint exact_div(uint nb, uint db) {
	uint Nn	 = (nb & 0x7FFFFFu) | 0x800000u;
	uint Dd	 = (db & 0x7FFFFFu) | 0x800000u;
	int	 eq	 = int((nb >> 23u) & 0xFFu) - int((db >> 23u) & 0xFFu);
	uint M24 = 0u;
	uint rem;
	int	 me;
	if (Nn >= Dd) {
		me	= eq;
		rem = Nn - Dd;
	} else {
		me	= eq - 1;
		rem = (Nn << 1u) - Dd;
	}
	for (int i = 0; i < 23; i++) {
		rem <<= 1u;
		M24 <<= 1u;
		if (rem >= Dd) {
			rem -= Dd;
			M24 |= 1u;
		}
	}
	uint r2 = rem << 1u;
	if (r2 > Dd || (r2 == Dd && (M24 & 1u) == 1u))
		M24++;
	if (M24 >= (1u << 23)) {
		M24 = 0u;
		me++;
	}
	int fe = me + 127;
	if (fe >= 255)
		return 0x7F800000u;
	if (fe <= 0)
		return 0u;
	return (uint(fe) << 23u) | M24;
}

int round_away(float f) {
	float af = abs(f);
	float tr = trunc(af);
	float fr = af - tr;
	float r	 = (fr >= 0.5) ? (tr + 1.0) : tr;
	return (f < 0.0) ? -int(r) : int(r);
}

void store_row(uint idx, float acc) {
	if (u_add_residual == 1)
		y[idx] = acc + res[idx];
	else if (u_add_residual == 2)
		y[idx] += acc;
	else
		y[idx] = acc;
}

void main(void) {
	uint base_row = (gl_WorkGroupID.x + gl_WorkGroupID.y * 65535u) * uint(ROWS);
	uint tid	  = gl_LocalInvocationID.x;
	bool r0		  = int(base_row + 0u) < u_n;
	bool r1		  = int(base_row + 1u) < u_n;
	bool r2		  = int(base_row + 2u) < u_n;
	bool r3		  = int(base_row + 3u) < u_n;
	uint rw0	  = r0 ? base_row + 0u : 0u;
	uint rw1	  = r1 ? base_row + 1u : 0u;
	uint rw2	  = r2 ? base_row + 2u : 0u;
	uint rw3	  = r3 ? base_row + 3u : 0u;

	float acc0 = 0.0, acc1 = 0.0, acc2 = 0.0, acc3 = 0.0;
	uint  row_bytes = uint(u_k_blocks) * 18u;
	for (uint li = tid; li < 16u; li += 32u) {
		uint g		= li >> 2u;
		uint v		= (g == 0u) ? IQ4NL_A0 : (g == 1u) ? IQ4NL_A1 : (g == 2u) ? IQ4NL_A2 : IQ4NL_A3;
		s_iq4nl[li] = int((v >> ((li & 3u) * 8u)) & 0xFFu) - 128;
	}
	barrier();
	for (int bi = int(tid); bi < u_k_blocks; bi += 32) {
		int	  xb   = bi * 32;
		float amax = 0.0;
		for (int j = 0; j < 32; j++) {
			float ax = abs(x[xb + j]);
			if (ax > amax)
				amax = ax;
		}
		uint  db	= (amax > 0.0) ? exact_div(f32_bits(amax), f32_bits(127.0)) : 0u;
		float d		= bits_f32(db);
		float id	= (db != 0u) ? 1.0 / d : 0.0;
		float dxq	= round_f16(d);
		uint  bo	= uint(bi) * 18u;
		int	  sumi0 = 0, sumi1 = 0, sumi2 = 0, sumi3 = 0;
		for (int j = 0; j < 16; j++) {
			int v0	= round_away(x[xb + j] * id);
			v0		= v0 > 127 ? 127 : (v0 < -127 ? -127 : v0);
			int v1	= round_away(x[xb + j + 16] * id);
			v1		= v1 > 127 ? 127 : (v1 < -127 ? -127 : v1);
			uint wj = bo + 2u + uint(j);
			uint b0 = rb(wj + rw0 * row_bytes);
			uint b1 = rb(wj + rw1 * row_bytes);
			uint b2 = rb(wj + rw2 * row_bytes);
			uint b3 = rb(wj + rw3 * row_bytes);
			sumi0 += v0 * iq4nl(b0 & 0xFu) + v1 * iq4nl(b0 >> 4);
			sumi1 += v0 * iq4nl(b1 & 0xFu) + v1 * iq4nl(b1 >> 4);
			sumi2 += v0 * iq4nl(b2 & 0xFu) + v1 * iq4nl(b2 >> 4);
			sumi3 += v0 * iq4nl(b3 & 0xFu) + v1 * iq4nl(b3 >> 4);
		}
		if (r0)
			acc0 += h2f(rb(bo + rw0 * row_bytes) | (rb(bo + 1u + rw0 * row_bytes) << 8u)) * dxq *
					float(sumi0);
		if (r1)
			acc1 += h2f(rb(bo + rw1 * row_bytes) | (rb(bo + 1u + rw1 * row_bytes) << 8u)) * dxq *
					float(sumi1);
		if (r2)
			acc2 += h2f(rb(bo + rw2 * row_bytes) | (rb(bo + 1u + rw2 * row_bytes) << 8u)) * dxq *
					float(sumi2);
		if (r3)
			acc3 += h2f(rb(bo + rw3 * row_bytes) | (rb(bo + 1u + rw3 * row_bytes) << 8u)) * dxq *
					float(sumi3);
	}
	s_acc[0][tid] = acc0;
	s_acc[1][tid] = acc1;
	s_acc[2][tid] = acc2;
	s_acc[3][tid] = acc3;
	barrier();
	for (uint s = 16u; s > 0u; s >>= 1u) {
		if (tid < s) {
			s_acc[0][tid] += s_acc[0][tid + s];
			s_acc[1][tid] += s_acc[1][tid + s];
			s_acc[2][tid] += s_acc[2][tid + s];
			s_acc[3][tid] += s_acc[3][tid + s];
		}
		barrier();
	}
	if (tid == 0u) {
		if (r0)
			store_row(base_row + 0u, s_acc[0][0]);
		if (r1)
			store_row(base_row + 1u, s_acc[1][0]);
		if (r2)
			store_row(base_row + 2u, s_acc[2][0]);
		if (r3)
			store_row(base_row + 3u, s_acc[3][0]);
	}
}

#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 64) in;

layout(location = 1) uniform int u_k;

#ifdef FUSED_ACT
layout(std430, binding = 0) readonly buffer GateBuf {
	float gate[];
};
layout(std430, binding = 2) readonly buffer UpBuf {
	float up[];
};
layout(location = 8) uniform int u_act;
layout(location = 9) uniform float u_gs;
layout(location = 10) uniform float u_us;
layout(location = 11) uniform int u_stride;
layout(location = 12) uniform int u_up_off;

float xin(uint i) {
	uint  r	 = i / uint(u_k);
	uint  c	 = i - r * uint(u_k);
	uint  gi = r * uint(u_stride) + c;
	float g	 = gate[gi] * u_gs;
	float u	 = up[gi + uint(u_up_off)] * u_us;
	float gv;
	if (u_act == 1) {
		float t = 0.7978845608 * (g + 0.044715 * g * g * g);
		gv		= 0.5 * g * (1.0 + tanh(t));
	} else {
		gv = g / (1.0 + exp(-g));
	}
	return gv * u;
}
#else
layout(std430, binding = 0) readonly buffer XBuf {
	float x[];
};

float xin(uint i) {
	return x[i];
}
#endif
layout(std430, binding = 1) writeonly buffer XQBuf {
	uint xq[];
};
layout(location = 0) uniform int u_k_blocks;
layout(location = 2) uniform int u_row_words;
layout(location = 3) uniform int u_row0;

float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}

float round_f16(float f) {
	float base = abs(f) * 4.0;
	uint  w	   = floatBitsToUint(f);
	uint  shl1 = w + w;
	uint  sign = w & 0x80000000u;
	uint  bias = shl1 & 0xFF000000u;
	if (bias < 0x71000000u)
		bias = 0x71000000u;
	base		   = uintBitsToFloat((bias >> 1u) + 0x07800000u) + base;
	uint bits	   = floatBitsToUint(base);
	uint exp_bits  = (bits >> 13u) & 0x7C00u;
	uint mant_bits = bits & 0x0FFFu;
	uint hbits	   = (sign >> 16u) | (shl1 > 0xFF000000u ? 0x7E00u : exp_bits + mant_bits);
	return h2f(hbits);
}

uint f32_bits(float f) {
	return floatBitsToUint(f);
}
float bits_f32(uint b) {
	return uintBitsToFloat(b);
}

uint exact_div(uint nb, uint db) {
	uint Nn	 = (nb & 0x7FFFFFu) | 0x800000u;
	uint Dd	 = (db & 0x7FFFFFu) | 0x800000u;
	int	 eq	 = int((nb >> 23u) & 0xFFu) - int((db >> 23u) & 0xFFu);
	uint M24 = 0u;
	uint rem;
	int	 me;
	if (Nn >= Dd) {
		me	= eq;
		rem = Nn - Dd;
	} else {
		me	= eq - 1;
		rem = (Nn << 1u) - Dd;
	}
	for (int i = 0; i < 23; i++) {
		rem <<= 1u;
		M24 <<= 1u;
		if (rem >= Dd) {
			rem -= Dd;
			M24 |= 1u;
		}
	}
	uint r2 = rem << 1u;
	if (r2 > Dd || (r2 == Dd && (M24 & 1u) == 1u))
		M24++;
	if (M24 >= (1u << 23)) {
		M24 = 0u;
		me++;
	}
	int fe = me + 127;
	if (fe >= 255)
		return 0x7F800000u;
	if (fe <= 0)
		return 0u;
	return (uint(fe) << 23u) | M24;
}

float div_r(float a, float b) {
	return bits_f32(exact_div(f32_bits(a), f32_bits(b)));
}

int round_away(float f) {
	float af = abs(f);
	float tr = trunc(af);
	float fr = af - tr;
	float r	 = (fr >= 0.5) ? (tr + 1.0) : tr;
	return (f < 0.0) ? -int(r) : int(r);
}
void main(void) {
	int bi	= int(gl_GlobalInvocationID.x);
	int row = int(gl_WorkGroupID.y) + u_row0;
	if (bi >= u_k_blocks)
		return;
	int	  xb = row * u_k + bi * 32;
	float xv[32];
	for (int j = 0; j < 32; j++)
		xv[j] = xin(uint(xb + j));
	float amax = 0.0;
	for (int j = 0; j < 32; j++) {
		float ax = abs(xv[j]);
		if (ax > amax)
			amax = ax;
	}
	uint  db  = (amax > 0.0) ? exact_div(f32_bits(amax), f32_bits(127.0)) : 0u;
	float d	  = bits_f32(db);
	float id  = (db != 0u) ? div_r(1.0, d) : 0.0;
	float dxq = round_f16(d);
	int	  qv[32];
	int	  qsum = 0;
	for (int j = 0; j < 32; j++) {
		int v = round_away(xv[j] * id);
		v	  = v > 127 ? 127 : (v < -127 ? -127 : v);
		qv[j] = v;
		qsum += v;
	}
	uint base = uint(row * u_row_words + bi * 44);
	for (int w = 0; w < 8; w++) {
		uint word = 0u;
		for (int b = 0; b < 4; b++)
			word |= (uint(qv[w * 4 + b]) & 0xFFu) << uint(b * 8);
		xq[base + uint(w)] = word;
	}
	xq[base + 8u]  = f32_bits(dxq);
	xq[base + 9u]  = f32_bits(d);
	xq[base + 10u] = uint(qsum);
	for (int i = 0; i < 4; i++) {
		for (int h = 0; h < 2; h++) {
			int	 e		 = h * 16 + i * 4;
			uint dst	 = base + uint(12 + i * 4 + h * 2);
			xq[dst]		 = uint(qv[e + 2] + (qv[e] << 16));
			xq[dst + 1u] = uint(qv[e + 3] + (qv[e + 1] << 16));
		}
	}
	for (int j = 0; j < 16; j++)
		xq[base + 28u + uint(j)] = uint(qv[j + 16] + (qv[j] << 16));
}

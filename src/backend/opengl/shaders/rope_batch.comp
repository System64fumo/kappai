#version 310 es
precision highp float;
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer VecBuf {
	float vec[];
};
layout(std430, binding = 1) readonly buffer CosBuf {
	float rcos[];
};
layout(std430, binding = 2) readonly buffer SinBuf {
	float rsin[];
};
layout(location = 0) uniform int u_n_heads;
layout(location = 1) uniform int u_head_dim;
layout(location = 2) uniform int u_m;
layout(location = 3) uniform int u_neox;
layout(location = 4) uniform int u_row_stride;
void main(void) {
	int half_dim = u_head_dim / 2;
	int per_row	 = u_n_heads * half_dim;
	int g		 = int(gl_GlobalInvocationID.x);
	if (g >= per_row * u_m)
		return;
	int	  row	= g / per_row;
	int	  t		= g - row * per_row;
	int	  h		= t / half_dim;
	int	  j		= t - h * half_dim;
	int	  base	= row * u_row_stride + h * u_head_dim;
	int	  cbase = row * half_dim + j;
	float c		= rcos[cbase];
	float s		= rsin[cbase];
	if (u_neox != 0) {
		float a					 = vec[base + j];
		float b					 = vec[base + j + half_dim];
		vec[base + j]			 = a * c - b * s;
		vec[base + j + half_dim] = a * s + b * c;
	} else {
		int	  i0	   = 2 * j;
		int	  i1	   = 2 * j + 1;
		float a		   = vec[base + i0];
		float b		   = vec[base + i1];
		vec[base + i0] = a * c - b * s;
		vec[base + i1] = a * s + b * c;
	}
}

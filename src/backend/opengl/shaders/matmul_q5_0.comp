#version 310 es
precision highp float;
precision highp int;

#ifndef WG
#define WG 32
#endif

layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly buffer WBuf {
	uint w[];
};
layout(std430, binding = 1) readonly buffer XQBuf {
	uvec4 xq4[];
};
layout(std430, binding = 2) buffer YBuf {
	float y[];
};
layout(std430, binding = 3) readonly buffer ResBuf {
	float res[];
};
layout(location = 0) uniform int u_n;
layout(location = 1) uniform int u_k_blocks;
layout(location = 2) uniform int u_add_residual;
layout(location = 9) uniform int u_m;
layout(location = 10) uniform int u_x_stride;
layout(location = 11) uniform int u_wg_base;

uint g_mi;

#define ROWS 4

#ifndef MT
#define MT 1
#endif

shared float s_acc[ROWS * MT][WG + 1];

float reduce_row(uint i) {
	float v = 0.0;
	for (int j = 0; j < WG; j++)
		v += s_acc[i][j];
	return v;
}

float h2f(uint h) {
	return unpackHalf2x16(h & 0xFFFFu).x;
}

uint sh2(uint a, uint b, uint odd) {
	return odd != 0u ? b : ((a >> 16u) | (b << 16u));
}

uint dot_pairs(uint qw, uvec4 xv) {
	return (qw & 0x000F000Fu) * xv.x + ((qw >> 8u) & 0x000F000Fu) * xv.y +
		   ((qw >> 4u) & 0x000F000Fu) * xv.z + ((qw >> 12u) & 0x000F000Fu) * xv.w;
}

uint hbit_dot(uint qh, uvec4 yv, uint j0) {
	return ((qh >> j0) & 0x00010001u) * yv.x + ((qh >> (j0 + 1u)) & 0x00010001u) * yv.y +
		   ((qh >> (j0 + 2u)) & 0x00010001u) * yv.z + ((qh >> (j0 + 3u)) & 0x00010001u) * yv.w;
}

int pair_field_sum(uint acc) {
	uint low = uint(bitfieldExtract(int(acc), 0, 16));
	return int(acc - low) >> 16;
}

uvec4 unpack_w(uint qw) {
	return uvec4(qw & 0x000F000Fu, (qw >> 8u) & 0x000F000Fu, (qw >> 4u) & 0x000F000Fu,
				 (qw >> 12u) & 0x000F000Fu);
}

uint dot_w(uvec4 wv, uvec4 xv) {
	return wv.x * xv.x + wv.y * xv.y + wv.z * xv.z + wv.w * xv.w;
}

#if MT > 1
void main(void) {
	uint wgid  = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	   = uint(max(u_m, 1));
	uint mt	   = (mb + uint(MT) - 1u) / uint(MT);
	uint col0  = (wgid % mt) * uint(MT);
	uint ncols = min(uint(MT), mb - col0);
	uint row0  = (wgid / mt) * uint(ROWS);
	uint tid   = gl_LocalInvocationID.x;
	uint last  = uint(max(u_n - 1, 0));

	uint  row_off[ROWS];
	float acc[ROWS * MT];
	for (int r = 0; r < ROWS; r++)
		row_off[r] = min(row0 + uint(r), last) * uint(u_k_blocks) * 22u;
	for (int i = 0; i < ROWS * MT; i++)
		acc[i] = 0.0;
	for (int bi = int(tid); bi < u_k_blocks; bi += WG) {
		for (int r = 0; r < ROWS; r++) {
			uint  bo  = row_off[r] + uint(bi) * 22u;
			uint  wi  = bo >> 2u;
			uint  odd = (bo >> 1u) & 1u;
			uint  w0  = w[wi];
			uint  w1  = w[wi + 1u];
			uint  w2  = w[wi + 2u];
			uint  w3  = w[wi + 3u];
			uint  w4  = w[wi + 4u];
			uint  w5  = w[wi + 5u];
			uint  qh  = sh2(w0, w1, odd);
			float wd  = h2f(odd != 0u ? w0 >> 16u : w0);
			uvec4 q0  = unpack_w(sh2(w1, w2, odd));
			uvec4 q1  = unpack_w(sh2(w2, w3, odd));
			uvec4 q2  = unpack_w(sh2(w3, w4, odd));
			uvec4 q3  = unpack_w(sh2(w4, w5, odd));
			for (int c = 0; c < MT; c++) {
				uint  xi  = min(col0 + uint(c), mb - 1u) * uint(u_x_stride) + uint(bi) * 11u;
				uvec4 xs  = xq4[xi + 2u];
				int	  nib = pair_field_sum(dot_w(q0, xq4[xi + 3u]) + dot_w(q1, xq4[xi + 4u])) +
							pair_field_sum(dot_w(q2, xq4[xi + 5u]) + dot_w(q3, xq4[xi + 6u]));
				int	  hs  = pair_field_sum(
					hbit_dot(qh, xq4[xi + 7u], 0u) + hbit_dot(qh, xq4[xi + 8u], 4u) +
					hbit_dot(qh, xq4[xi + 9u], 8u) + hbit_dot(qh, xq4[xi + 10u], 12u));
				acc[r * MT + c] +=
					wd * uintBitsToFloat(xs.x) * float(nib + 16 * hs - 16 * int(xs.z));
			}
		}
	}
	for (int i = 0; i < ROWS * MT; i++)
		s_acc[i][tid] = acc[i];
	barrier();
	for (uint i = tid; i < uint(ROWS * MT); i += uint(WG)) {
		uint r	 = i / uint(MT);
		uint c	 = i % uint(MT);
		uint row = row0 + r;
		if (int(row) < u_n && c < ncols) {
			uint  yi = (col0 + c) * uint(u_n) + row;
			float v	 = reduce_row(i);
			if (u_add_residual == 1)
				y[yi] = v + res[row];
			else if (u_add_residual == 2)
				y[yi] += v;
			else
				y[yi] = v;
		}
	}
}
#else
void main(void) {
	uint wgid = gl_WorkGroupID.x + uint(u_wg_base);
	uint mb	  = uint(max(u_m, 1));
	g_mi	  = wgid % mb;
	wgid	  = wgid / mb;
	uint row0 = wgid * uint(ROWS);
	uint tid  = gl_LocalInvocationID.x;
	uint last = uint(max(u_n - 1, 0));

	uint  row_off[ROWS];
	float acc[ROWS];
	for (int r = 0; r < ROWS; r++) {
		row_off[r] = min(row0 + uint(r), last) * uint(u_k_blocks) * 22u;
		acc[r]	   = 0.0;
	}
	for (int bi = int(tid); bi < u_k_blocks; bi += WG) {
		uint  xi  = g_mi * uint(u_x_stride) + uint(bi) * 11u;
		uvec4 xs  = xq4[xi + 2u];
		float dxq = uintBitsToFloat(xs.x);
		int	  off = 16 * int(xs.z);
		for (int r = 0; r < ROWS; r++) {
			uint  bo  = row_off[r] + uint(bi) * 22u;
			uint  wi  = bo >> 2u;
			uint  odd = (bo >> 1u) & 1u;
			uint  w0  = w[wi];
			uint  w1  = w[wi + 1u];
			uint  w2  = w[wi + 2u];
			uint  w3  = w[wi + 3u];
			uint  w4  = w[wi + 4u];
			uint  w5  = w[wi + 5u];
			uint  qh  = sh2(w0, w1, odd);
			float wd  = h2f(odd != 0u ? w0 >> 16u : w0);
			int	  nib = pair_field_sum(dot_pairs(sh2(w1, w2, odd), xq4[xi + 3u]) +
									   dot_pairs(sh2(w2, w3, odd), xq4[xi + 4u])) +
						pair_field_sum(dot_pairs(sh2(w3, w4, odd), xq4[xi + 5u]) +
									   dot_pairs(sh2(w4, w5, odd), xq4[xi + 6u]));
			int	  hs =
				pair_field_sum(hbit_dot(qh, xq4[xi + 7u], 0u) + hbit_dot(qh, xq4[xi + 8u], 4u) +
							   hbit_dot(qh, xq4[xi + 9u], 8u) + hbit_dot(qh, xq4[xi + 10u], 12u));
			acc[r] += wd * dxq * float(nib + 16 * hs - off);
		}
	}
	for (int r = 0; r < ROWS; r++)
		s_acc[r][tid] = acc[r];
	barrier();
	if (tid < uint(ROWS)) {
		uint row = row0 + tid;
		if (int(row) < u_n) {
			float v = reduce_row(tid);
			if (u_add_residual == 1)
				y[g_mi * uint(u_n) + row] = v + res[row];
			else if (u_add_residual == 2)
				y[g_mi * uint(u_n) + row] += v;
			else
				y[g_mi * uint(u_n) + row] = v;
		}
	}
}
#endif

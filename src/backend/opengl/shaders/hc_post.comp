#version 310 es
precision highp float;
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer SubBuf {
	float sub[];
};
layout(std430, binding = 1) readonly buffer CoefBuf {
	float coef[];
};
layout(std430, binding = 2) buffer HcBuf {
	float hc[];
};
layout(location = 0) uniform int u_dim;
layout(location = 1) uniform int u_n_hc;

const int MAX_HC = 8;

void main(void) {
	int i = int(gl_GlobalInvocationID.x);
	if (i >= u_dim)
		return;
	float cur[MAX_HC];
	for (int h = 0; h < u_n_hc; h++)
		cur[h] = hc[h * u_dim + i];
	float s = sub[i];
	for (int dst = 0; dst < u_n_hc; dst++) {
		float acc = s * coef[dst];
		for (int src = 0; src < u_n_hc; src++)
			acc += cur[src] * coef[u_n_hc + dst + src * u_n_hc];
		hc[dst * u_dim + i] = acc;
	}
}

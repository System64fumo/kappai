#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

layout(local_size_x_id = 0) in;

layout(constant_id = 2) const int TILE_K = 2048;

layout(set = 0, binding = 0) readonly buffer W0Buf {
	uint w0[];
};
layout(set = 0, binding = 1) readonly buffer XBuf {
	float x[];
};
#ifdef HAS_RESIDUAL
layout(set = 0, binding = 2) readonly buffer RBuf {
	float residual[];
};
layout(set = 0, binding = 3) writeonly buffer Y0Buf {
	float y0[];
};
#else
layout(set = 0, binding = 2) writeonly buffer Y0Buf {
	float y0[];
};
#endif

layout(push_constant) uniform Params {
	int n0;
	int n1;
	int k;
	int m;
}
params;

#include "common.glsl"

#define W_NAME w0
#define W_PFX w0_
#include "weight_io.glsl"
#undef W_NAME
#undef W_PFX

const int  BLOCK			  = 256;
const int  BLOCKS_PER_TILE	  = TILE_K / BLOCK;
const uint IQ4_XS_BLOCK_BYTES = 136u;

const int KVALUES[16] =
	int[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113);

shared float x_shared[TILE_K];
shared uint	 xq_packed[TILE_K / 4];
shared float xq_d[BLOCKS_PER_TILE];

#include "quant_x8_block.glsl"

void main() {
	uint i	 = gl_GlobalInvocationID.x;
	uint tid = gl_LocalInvocationID.x;
	int	 k	 = params.k;

	int	 blocks_per_row = k / 256;
	uint row_stride		= uint(blocks_per_row) * IQ4_XS_BLOCK_BYTES;

	uint row	= gl_WorkGroupID.y;
	uint x_off	= row * uint(k);
	uint y0_off = row * uint(params.n0);
#ifdef HAS_RESIDUAL
	uint r_off = y0_off;
#endif

	precise float acc0	 = 0.0;
	bool		  valid0 = (int(i) < params.n0);

	for (int tile_start = 0; tile_start < k; tile_start += TILE_K) {
		int tile_end = min(tile_start + TILE_K, k);
		int tile_len = tile_end - tile_start;

		for (int j = int(tid); j < tile_len; j += int(gl_WorkGroupSize.x)) {
			x_shared[j] = x[x_off + uint(tile_start + j)];
		}
		barrier();

		int block_start = tile_start / 256;
		int block_end	= tile_end / 256;

		for (int bi = block_start + int(tid); bi < block_end; bi += int(gl_WorkGroupSize.x)) {
			xq8_quant_superblock(bi, block_start, tile_start);
		}
		barrier();

		if (valid0) {
			uint row_off = i * row_stride;

			for (int bi = block_start; bi < block_end; bi++) {
				uint  block_off = row_off + uint(bi) * IQ4_XS_BLOCK_BYTES;
				float d_w		= half_to_float(w0_read_u16(block_off));
				uint  scales_h	= w0_read_u16(block_off + 2u);

				int	  local_bi = bi - block_start;
				int	  x_base   = bi * 256 - tile_start;
				float xd	   = xq_d[local_bi];

				uint qs_off		= block_off + 8u;
				uint scales_off = block_off + 4u;

				for (int ib = 0; ib < 8; ib++) {
					uint  sl_byte = w0_read_u8(scales_off + uint(ib >> 1));
					uint  sl	  = (sl_byte >> uint(4 * (ib & 1))) & 0xFu;
					uint  sh	  = (scales_h >> uint(2 * ib)) & 3u;
					float dl	  = d_w * (float(int(sl | (sh << 4u))) - 32.0);
					uint  qs_b	  = qs_off + uint(ib) * 16u;

					for (int w = 0; w < 4; w++) {
						int s0 = KVALUES[int(w0_read_u8(qs_b + uint(w * 4 + 0)) & 0xFu)];
						int s1 = KVALUES[int(w0_read_u8(qs_b + uint(w * 4 + 1)) & 0xFu)];
						int s2 = KVALUES[int(w0_read_u8(qs_b + uint(w * 4 + 2)) & 0xFu)];
						int s3 = KVALUES[int(w0_read_u8(qs_b + uint(w * 4 + 3)) & 0xFu)];
						int s4 = KVALUES[int(w0_read_u8(qs_b + uint(w * 4 + 0)) >> 4u)];
						int s5 = KVALUES[int(w0_read_u8(qs_b + uint(w * 4 + 1)) >> 4u)];
						int s6 = KVALUES[int(w0_read_u8(qs_b + uint(w * 4 + 2)) >> 4u)];
						int s7 = KVALUES[int(w0_read_u8(qs_b + uint(w * 4 + 3)) >> 4u)];

						int xw0 = (x_base + ib * 32 + w * 4) >> 2;
						int xw1 = xw0 + 4;
						int sum =
							dotPacked4x8EXT(
								pack32(i8vec4(int8_t(s0), int8_t(s1), int8_t(s2), int8_t(s3))),
								int(xq_packed[xw0])) +
							dotPacked4x8EXT(
								pack32(i8vec4(int8_t(s4), int8_t(s5), int8_t(s6), int8_t(s7))),
								int(xq_packed[xw1]));

						acc0 = fma(dl * xd, float(sum), acc0);
					}
				}
			}
		}
		barrier();
	}

#if defined(HAS_RESIDUAL)
	if (valid0)
		y0[y0_off + i] = acc0 + residual[r_off + i];
#else
	if (valid0)
		y0[y0_off + i] = acc0;
#endif
}

#version 450
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x_id = 3) in;

layout(set = 0, binding = 0) readonly buffer QBuf {
	float q[];
};
layout(set = 0, binding = 1) readonly buffer KBuf {
	uint kcache[];
};
layout(set = 0, binding = 2) readonly buffer VBuf {
	uint vcache[];
};
layout(set = 0, binding = 3) writeonly buffer OutBuf {
	float out_[];
};

layout(push_constant) uniform Params {
	uint  layer_off;
	int	  pos;
	int	  n_heads;
	int	  n_kv_heads;
	int	  head_dim;
	int	  n_ctx;
	float scale;
	int	  stride_head_dim;
	int	  attn_start;
	int	  kv_q8;
	int	  kv_row_bytes;
#ifdef BATCHED
	int m;
#endif
}
params;

layout(constant_id = 0) const int HEAD_DIM	   = 64;
layout(constant_id = 1) const int HEADS_PER_WG = 1;
layout(constant_id = 2) const int LANES		   = 16;
layout(constant_id = 3) const int LOCAL_SIZE_X = 64;
layout(constant_id = 4) const int TILE_T	   = 16;
layout(constant_id = 5) const int T_SPLIT	   = 1;

#include "common.glsl"

const int DPL		  = HEAD_DIM / LANES;
const int KSTRIDE	  = HEAD_DIM + 4;
const int MAX_DPL	  = 16;
const int PART_STRIDE = MAX_DPL + 2;

shared float k_tile[TILE_T * KSTRIDE];
shared float v_tile[TILE_T * HEAD_DIM];
shared float s_tile[HEADS_PER_WG * TILE_T];
shared float part[HEADS_PER_WG * T_SPLIT * LANES * PART_STRIDE];

void main() {
	const uint tid	 = gl_LocalInvocationID.x;
	const int  s	 = int(tid) / LANES;
	const int  lane	 = int(tid) % LANES;
	const int  hslot = s % HEADS_PER_WG;
	const int  tslot = s / HEADS_PER_WG;
	const int  slot	 = tslot * LANES + lane;

	const int n_groups	= params.n_heads / params.n_kv_heads;
	const int wg_per_kv = n_groups / HEADS_PER_WG;
	const int kvh		= int(gl_WorkGroupID.x) / wg_per_kv;
	const int my_head = kvh * n_groups + (int(gl_WorkGroupID.x) % wg_per_kv) * HEADS_PER_WG + hslot;

#ifdef BATCHED
	const uint row		 = gl_WorkGroupID.y;
	const uint q_row_off = gl_WorkGroupID.y * uint(params.n_heads) * uint(HEAD_DIM);
	const int  pos		 = params.pos + int(gl_WorkGroupID.y);
#else
	const uint q_row_off = 0u;
	const int  pos		 = params.pos;
#endif

	const int  attn_start = params.attn_start;
	const uint stride_head =
		(params.kv_q8 != 0) ? uint(params.kv_row_bytes) : uint(params.stride_head_dim);
	const uint kv_base = params.layer_off + uint(kvh) * uint(params.n_ctx) * stride_head;
	const uint q_base  = q_row_off + uint(my_head) * uint(HEAD_DIM);
	const int  hs	   = hslot * TILE_T;

	precise float M = neg_max_float();
	precise float S = 0.0;
	precise float vkq[MAX_DPL];
	for (int i = 0; i < DPL; i++)
		vkq[i] = 0.0;

	const int words_head = HEAD_DIM / 2;
	for (int tile_t0 = attn_start; tile_t0 <= pos; tile_t0 += TILE_T) {
		const int tile_t1	 = min(tile_t0 + TILE_T, pos + 1);
		const int tile_len	 = tile_t1 - tile_t0;
		const int words_tile = tile_len * words_head;

		for (int idx = int(tid); idx < words_tile; idx += LOCAL_SIZE_X) {
			const int t	 = idx / words_head;
			const int dw = idx % words_head;
			const int d0 = dw * 2;
			const int d1 = d0 + 1;
			if (params.kv_q8 == 0) {
				const uint ko			  = kv_base + uint(tile_t0 + t) * stride_head + uint(d0);
				const vec2 kf			  = vec2(unpackHalf2x16(kcache[ko >> 1u]));
				const vec2 vf			  = vec2(unpackHalf2x16(vcache[ko >> 1u]));
				k_tile[t * KSTRIDE + d0]  = kf.x;
				k_tile[t * KSTRIDE + d1]  = kf.y;
				v_tile[t * HEAD_DIM + d0] = vf.x;
				v_tile[t * HEAD_DIM + d1] = vf.y;
			} else {
				uint ko = kv_base + uint(tile_t0 + t) * stride_head;
				// k d0
				int	  b0	= d0 >> 5;
				int	  o0	= d0 & 31;
				uint  soff0 = ko + uint(b0) * 34u;
				uint  w0	= kcache[soff0 >> 2u];
				float sk0	= unpackHalf2x16((w0 >> ((soff0 & 2u) * 8u)) & 0xFFFFu).x;
				uint  wb0	= kcache[(soff0 + 2u + uint(o0)) >> 2u];
				int	  qk0	= int((wb0 >> (((soff0 + 2u + uint(o0)) & 3u) * 8u)) & 0xFFu);
				if (qk0 > 127)
					qk0 -= 256;
				k_tile[t * KSTRIDE + d0] = sk0 * float(qk0);
				// k d1
				int	  b1	= d1 >> 5;
				int	  o1	= d1 & 31;
				uint  soff1 = ko + uint(b1) * 34u;
				uint  w1	= kcache[soff1 >> 2u];
				float sk1	= unpackHalf2x16((w1 >> ((soff1 & 2u) * 8u)) & 0xFFFFu).x;
				uint  wb1	= kcache[(soff1 + 2u + uint(o1)) >> 2u];
				int	  qk1	= int((wb1 >> (((soff1 + 2u + uint(o1)) & 3u) * 8u)) & 0xFFu);
				if (qk1 > 127)
					qk1 -= 256;
				k_tile[t * KSTRIDE + d1] = sk1 * float(qk1);
				// v d0
				uint  vo0 = vcache[soff0 >> 2u];
				float sv0 = unpackHalf2x16((vo0 >> ((soff0 & 2u) * 8u)) & 0xFFFFu).x;
				uint  vb0 = vcache[(soff0 + 2u + uint(o0)) >> 2u];
				int	  qv0 = int((vb0 >> (((soff0 + 2u + uint(o0)) & 3u) * 8u)) & 0xFFu);
				if (qv0 > 127)
					qv0 -= 256;
				v_tile[t * HEAD_DIM + d0] = sv0 * float(qv0);
				// v d1
				uint  vo1 = vcache[soff1 >> 2u];
				float sv1 = unpackHalf2x16((vo1 >> ((soff1 & 2u) * 8u)) & 0xFFFFu).x;
				uint  vb1 = vcache[(soff1 + 2u + uint(o1)) >> 2u];
				int	  qv1 = int((vb1 >> (((soff1 + 2u + uint(o1)) & 3u) * 8u)) & 0xFFu);
				if (qv1 > 127)
					qv1 -= 256;
				v_tile[t * HEAD_DIM + d1] = sv1 * float(qv1);
			}
		}
		barrier();

		for (int t = slot; t < tile_len; t += T_SPLIT * LANES) {
			precise float acc = 0.0;
			const int	  kb  = t * KSTRIDE;
			for (int d = 0; d < HEAD_DIM; d += 4)
				acc += dot(vec4(q[q_base + uint(d)], q[q_base + uint(d + 1)],
								q[q_base + uint(d + 2)], q[q_base + uint(d + 3)]),
						   vec4(k_tile[kb + d], k_tile[kb + d + 1], k_tile[kb + d + 2],
								k_tile[kb + d + 3]));
			s_tile[hs + t] = acc * params.scale;
		}
		barrier();

		for (int t = tslot; t < tile_len; t += T_SPLIT) {
			const precise float score = s_tile[hs + t];
			const precise float m_new = max(M, score);
			const precise float ms	  = exp(M - m_new);
			const precise float vs	  = exp(score - m_new);

			const int vb = t * HEAD_DIM + lane * DPL;
			for (int i = 0; i < DPL; i += 4) {
				const vec4 vv = vec4(v_tile[vb + i], v_tile[vb + i + 1], v_tile[vb + i + 2],
									 v_tile[vb + i + 3]);
				vkq[i]		  = vkq[i] * ms + vv.x * vs;
				vkq[i + 1]	  = vkq[i + 1] * ms + vv.y * vs;
				vkq[i + 2]	  = vkq[i + 2] * ms + vv.z * vs;
				vkq[i + 3]	  = vkq[i + 3] * ms + vv.w * vs;
			}

			S = S * ms + vs;
			M = m_new;
		}
		barrier();
	}

	const int part_lane = (hslot * T_SPLIT) * LANES + lane;
	const int pb		= (part_lane + tslot * LANES) * PART_STRIDE;
	for (int i = 0; i < DPL; i++)
		part[pb + i] = vkq[i];
	part[pb + DPL]	   = M;
	part[pb + DPL + 1] = S;
	barrier();

	if (tslot != 0)
		return;

	precise float m_all = part[pb + DPL];
	for (int sidx = 1; sidx < T_SPLIT; sidx++)
		m_all = max(m_all, part[(part_lane + sidx * LANES) * PART_STRIDE + DPL]);

	precise float s_all = 0.0;
	for (int sidx = 0; sidx < T_SPLIT; sidx++) {
		const int off = (part_lane + sidx * LANES) * PART_STRIDE;
		s_all += part[off + DPL + 1] * exp(part[off + DPL] - m_all);
	}
	const precise float inv_s = s_all > 0.0 ? 1.0 / s_all : 0.0;

	const uint d0 = q_base + uint(lane * DPL);
	for (int i = 0; i < DPL; i++) {
		precise float acc = 0.0;
		for (int sidx = 0; sidx < T_SPLIT; sidx++) {
			const int off = (part_lane + sidx * LANES) * PART_STRIDE;
			acc += part[off + i] * exp(part[off + DPL] - m_all);
		}
		out_[d0 + uint(i)] = acc * inv_s;
	}
	if (params.kv_q8 != 0 && params.layer_off == 0u && gl_WorkGroupID.x == 0u &&
		gl_LocalInvocationID.x == 0u) {
		out_[0] = k_tile[0];
	}
}

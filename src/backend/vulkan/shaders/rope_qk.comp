#version 450
layout(local_size_x = 128) in;

layout(set = 0, binding = 0) buffer QBuf {
	mediump float q[];
};
layout(set = 0, binding = 1) buffer KBuf {
	mediump float k[];
};
layout(set = 0, binding = 2) readonly buffer CosBuf {
	mediump float rcos[];
};
layout(set = 0, binding = 3) readonly buffer SinBuf {
	mediump float rsin[];
};

layout(push_constant) uniform Params {
	int n_heads;
	int n_kv_heads;
	int head_dim;
	int pos;
	int neox;
	int m;
	int rope_dim;
}
params;

void main() {
	uint gid	 = gl_GlobalInvocationID.x;
	int	 rd2	 = (params.rope_dim > 0 ? params.rope_dim : params.head_dim) / 2;
	int	 total_q = params.n_heads * rd2;
	int	 total_k = params.n_kv_heads * rd2;

	uint row = gl_WorkGroupID.y;
	if (row >= uint(params.m))
		return;
	int	 pos	   = params.pos + int(row);
	uint q_row_off = row * uint(params.n_heads) * uint(params.head_dim);
	uint k_row_off = row * uint(params.n_kv_heads) * uint(params.head_dim);

	if (int(gid) < total_q) {
		int h = int(gid) / rd2;
		int j = int(gid) % rd2;
		mediump float c	   = rcos[uint(pos) * uint(rd2) + uint(j)];
		mediump float s	   = rsin[uint(pos) * uint(rd2) + uint(j)];
		uint		  base = q_row_off + uint(h) * uint(params.head_dim);
		if (params.neox != 0) {
			mediump float v0			  = q[base + uint(j)];
			mediump float v1			  = q[base + uint(j) + uint(rd2)];
			q[base + uint(j)]			  = v0 * c - v1 * s;
			q[base + uint(j) + uint(rd2)] = v0 * s + v1 * c;
		} else {
			mediump float v0		  = q[base + uint(j * 2)];
			mediump float v1		  = q[base + uint(j * 2 + 1)];
			q[base + uint(j * 2)]	  = v0 * c - v1 * s;
			q[base + uint(j * 2 + 1)] = v0 * s + v1 * c;
		}
		return;
	}

	uint kid = gid - uint(total_q);
	if (int(kid) < total_k) {
		int h = int(kid) / rd2;
		int j = int(kid) % rd2;
		mediump float c	   = rcos[uint(pos) * uint(rd2) + uint(j)];
		mediump float s	   = rsin[uint(pos) * uint(rd2) + uint(j)];
		uint		  base = k_row_off + uint(h) * uint(params.head_dim);
		if (params.neox != 0) {
			mediump float v0			  = k[base + uint(j)];
			mediump float v1			  = k[base + uint(j) + uint(rd2)];
			k[base + uint(j)]			  = v0 * c - v1 * s;
			k[base + uint(j) + uint(rd2)] = v0 * s + v1 * c;
		} else {
			mediump float v0		  = k[base + uint(j * 2)];
			mediump float v1		  = k[base + uint(j * 2 + 1)];
			k[base + uint(j * 2)]	  = v0 * c - v1 * s;
			k[base + uint(j * 2 + 1)] = v0 * s + v1 * c;
		}
	}
}

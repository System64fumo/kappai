void main() {
	uint i	 = gl_GlobalInvocationID.x;
	uint tid = gl_LocalInvocationID.x;
	int	 k	 = params.k;

	int	 blocks_per_row = k / 256;
	uint row_stride		= uint(blocks_per_row) * IQ2_XXS_BLOCK_BYTES;

	uint row	= gl_WorkGroupID.y;
	uint x_off	= row * uint(k);
	uint y0_off = row * uint(params.n0);

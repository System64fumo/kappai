						uint lo_val = uint((lo4 | (lo_bit << 4)) - 16) & 0xFFu;
						uint hi_val = uint((hi4 | (hi_bit << 4)) - 16) & 0xFFu;
						lo_word |= lo_val << uint(b * 8);
						hi_word |= hi_val << uint(b * 8);
					}

					sumi += dotPacked4x8EXT(int(lo_word), int(xq_packed[wp + w4]));
					sumi += dotPacked4x8EXT(int(hi_word), int(xq_packed[wp + 4 + w4]));
				}

				acc[r] = fma(d, float(sumi), acc[r]);
			}
		}
		barrier();
	}

	for (int r = 0; r < ROWS_PER_THREAD; r++) {
		if (!valid[r])
			continue;
		y[y_off + base_i + uint(r)] =
			acc[r] + (params.res_mode != 0 ? residual[r_off + base_i + uint(r)] : 0.0);
	}
}

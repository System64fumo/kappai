#undef W_PFX

#if NMAT >= 2
#define W_NAME w1
#define W_PFX w1_
#include "weight_io.glsl"
#undef W_NAME
#undef W_PFX
#endif

const int BLOCK			  = 256;
const int BLOCKS_PER_TILE = TILE_K / BLOCK;

shared float x_shared[TILE_K];
shared uint	 xq_packed[TILE_K / 4];
shared float xq_d[BLOCKS_PER_TILE];
shared int	 xq_bsums[BLOCKS_PER_TILE * 16];

#define XQ_HAVE_BSUMS 1
#include "quant_x8_block.glsl"
#undef XQ_HAVE_BSUMS

void main() {
	uint i	 = gl_GlobalInvocationID.x;
	uint tid = gl_LocalInvocationID.x;
	int	 k	 = params.k;

	int blocks_per_row = k / 256;

	uint row	= gl_WorkGroupID.y;
	uint x_off	= row * uint(k);
	uint y0_off = row * uint(params.n0);
	uint r_off	= y0_off;
#if NMAT >= 2
	uint y1_off = row * uint(params.n1);
#endif

	precise float acc0	 = 0.0;
	bool		  valid0 = (int(i) < params.n0);

#if NMAT >= 2
	precise float acc1	 = 0.0;
	bool		  valid1 = (int(i) < params.n1);
#endif

	for (int tile_start = 0; tile_start < k; tile_start += TILE_K) {
		int tile_end = min(tile_start + TILE_K, k);
		int tile_len = tile_end - tile_start;

		for (int j = int(tid); j < tile_len; j += int(gl_WorkGroupSize.x)) {
			x_shared[j] = x[x_off + uint(tile_start + j)];
		}
		barrier();

		int block_start = tile_start / 256;
		int block_end	= tile_end / 256;

		for (int bi = block_start + int(tid); bi < block_end; bi += int(gl_WorkGroupSize.x)) {
			xq8_quant_superblock(bi, block_start, tile_start);
		}
		barrier();

		if (valid0) {
			uint row_off = i * uint(blocks_per_row) * Q4_K_BLOCK_BYTES;

			for (int bi = block_start; bi < block_end; bi++) {
				uint  block_off = row_off + uint(bi) * Q4_K_BLOCK_BYTES;
				float d			= half_to_float(w0_read_u16(block_off + 0u));
				float dmin		= half_to_float(w0_read_u16(block_off + 2u));

				int	  local_bi = bi - block_start;
				float xd	   = xq_d[local_bi];

				int	 sumi = 0, summ = 0;
				uint s_off = block_off + 4u;
				uint q_off = block_off + 16u;
				int	 ib	   = local_bi * 16;
				int	 wp	   = (bi * 256 - tile_start) >> 2;

				uint sc_d[8], sc_m[8];
				w0_get_all_scale_min_k4(s_off, sc_d, sc_m);

				for (int g = 0; g < 4; g++) {
					int is = g * 2;
					int s0 = int(sc_d[is]), m0 = int(sc_m[is]);
					int s1 = int(sc_d[is + 1]), m1 = int(sc_m[is + 1]);

					int dot0 = 0, dot1 = 0;
					for (int l = 0; l < 32; l += 4) {
						uint word		= w0_read_u32(q_off + uint(g * 32 + l));
						int	 lo_nibbles = int(word & 0x0F0F0F0Fu);
						int	 hi_nibbles = int((word >> 4) & 0x0F0F0F0Fu);

						dot0 += dotPacked4x8EXT(lo_nibbles, int(xq_packed[wp + g * 16 + l / 4]));
						dot1 +=
							dotPacked4x8EXT(hi_nibbles, int(xq_packed[wp + g * 16 + l / 4 + 8]));
					}
					sumi += s0 * dot0 + s1 * dot1;
					summ += m0 * (xq_bsums[ib] + xq_bsums[ib + 1]);
					ib += 2;
					summ += m1 * (xq_bsums[ib] + xq_bsums[ib + 1]);
					ib += 2;
				}
				acc0 = fma(xd, d * float(sumi) - dmin * float(summ), acc0);
			}
		}

#if NMAT >= 2
		if (valid1) {
			uint row_off = i * uint(blocks_per_row) * Q4_K_BLOCK_BYTES;
			for (int bi = block_start; bi < block_end; bi++) {
				uint  block_off = row_off + uint(bi) * Q4_K_BLOCK_BYTES;
				float d			= half_to_float(w1_read_u16(block_off + 0u));
				float dmin		= half_to_float(w1_read_u16(block_off + 2u));

				int	  local_bi = bi - block_start;
				float xd	   = xq_d[local_bi];

				int	 sumi = 0, summ = 0;
				uint s_off = block_off + 4u;
				uint q_off = block_off + 16u;
				int	 ib	   = local_bi * 16;
				int	 wp	   = (bi * 256 - tile_start) >> 2;

				uint sc_d[8], sc_m[8];
				w1_get_all_scale_min_k4(s_off, sc_d, sc_m);

				for (int g = 0; g < 4; g++) {
					int is = g * 2;
					int s0 = int(sc_d[is]), m0 = int(sc_m[is]);
					int s1 = int(sc_d[is + 1]), m1 = int(sc_m[is + 1]);

					int dot0 = 0, dot1 = 0;
					for (int l = 0; l < 32; l += 4) {
						uint word		= w1_read_u32(q_off + uint(g * 32 + l));
						int	 lo_nibbles = int(word & 0x0F0F0F0Fu);
						int	 hi_nibbles = int((word >> 4) & 0x0F0F0F0Fu);

						dot0 += dotPacked4x8EXT(lo_nibbles, int(xq_packed[wp + g * 16 + l / 4]));
						dot1 +=
							dotPacked4x8EXT(hi_nibbles, int(xq_packed[wp + g * 16 + l / 4 + 8]));
					}
					sumi += s0 * dot0 + s1 * dot1;
					summ += m0 * (xq_bsums[ib] + xq_bsums[ib + 1]);
					ib += 2;
					summ += m1 * (xq_bsums[ib] + xq_bsums[ib + 1]);
					ib += 2;
				}
				acc1 = fma(xd, d * float(sumi) - dmin * float(summ), acc1);
			}
		}
#endif
		barrier();
	}

#if NMAT >= 2
	if (valid0)
		y0[y0_off + i] = acc0;
	if (valid1)
		y1[y1_off + i] = acc1;
#else
	if (valid0)
		y0[y0_off + i] = acc0 + (params.res_mode != 0 ? residual[r_off + i] : 0.0);
#endif
}
#endif


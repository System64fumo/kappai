layout(constant_id = 2) const int TILE_K		  = 2048;

#include "common.glsl"

#define W_NAME w0
#define W_PFX w0_
#include "weight_io.glsl"
#undef W_NAME
#undef W_PFX

shared float x_shared[TILE_K];
shared uint	 xq_packed[TILE_K / 4];
shared float xq_d[TILE_K / 32];
shared float xq_s[TILE_K / 32];

#include "xq8_block.glsl"

void main() {
	uint base_i			= gl_GlobalInvocationID.x * uint(ROWS_PER_THREAD);
	uint tid			= gl_LocalInvocationID.x;
	int	 k				= params.k;
	int	 blocks_per_row = k / 32;

	uint row   = gl_WorkGroupID.y;
	uint x_off = row * uint(k);
	uint y_off = row * uint(params.n0);
	uint r_off = y_off;

	precise float acc[ROWS_PER_THREAD];
	precise float off[ROWS_PER_THREAD];
	for (int r = 0; r < ROWS_PER_THREAD; r++) {
		acc[r] = 0.0;
		off[r] = 0.0;
	}
	bool valid[ROWS_PER_THREAD];
	for (int r = 0; r < ROWS_PER_THREAD; r++)
		valid[r] = (int(base_i) + r < params.n0);

	for (int tile_start = 0; tile_start < k; tile_start += TILE_K) {
		int tile_end = min(tile_start + TILE_K, k);
		int tile_len = tile_end - tile_start;

		for (int j = int(tid); j < tile_len; j += int(gl_WorkGroupSize.x))
			x_shared[j] = x[x_off + uint(tile_start + j)];
		barrier();

		int block_start = tile_start / 32;
		int block_end	= tile_end / 32;

		for (int bi = block_start + int(tid); bi < block_end; bi += int(gl_WorkGroupSize.x)) {
			int	  local_bi = bi - block_start;
			float d;
			int	  sum	   = xq8_quant_block(bi * 32 - tile_start, d);
			xq_d[local_bi] = f32_to_f16_to_f32(d);
			xq_s[local_bi] = f32_to_f16_to_f32(d * float(sum));
		}
		barrier();

		for (int bi = block_start; bi < block_end; bi++) {
			int	  x_base = bi * 32 - tile_start;
			float d_xq	 = xq_d[bi - block_start];
			float s_xq	 = xq_s[bi - block_start];

			int wp = x_base >> 2;
			for (int r = 0; r < ROWS_PER_THREAD; r++) {
				if (!valid[r])
					continue;
				uint row_idx = base_i + uint(r);
				uint block_off =
					row_idx * uint(blocks_per_row) * Q5_1_BLOCK_BYTES + uint(bi) * Q5_1_BLOCK_BYTES;
				float d		 = half_to_float(w0_read_u16(block_off)) * d_xq;
				uint  qh	 = w0_read_u32(block_off + 4u);
				uint  qs_off = block_off + 8u;

				int sumi = 0;
				for (int w4 = 0; w4 < 4; w4++) {
					uint word		= w0_read_u32(qs_off + uint(w4 * 4));
					int	 lo_nibbles = int(word & 0x0F0F0F0Fu);
					int	 hi_nibbles = int((word >> 4) & 0x0F0F0F0Fu);
					int	 j			= w4 * 4;

					int lo_qh	= int((qh >> uint(j)) & 1u) | (int((qh >> uint(j + 1)) & 1u) << 8) |
								  (int((qh >> uint(j + 2)) & 1u) << 16) |
								  (int((qh >> uint(j + 3)) & 1u) << 24);
					int hi_qh	= int((qh >> uint(j + 16)) & 1u) |
								  (int((qh >> uint(j + 17)) & 1u) << 8) |
								  (int((qh >> uint(j + 18)) & 1u) << 16) |
								  (int((qh >> uint(j + 19)) & 1u) << 24);
					int lo_vals = lo_nibbles | (lo_qh << 4);
					int hi_vals = hi_nibbles | (hi_qh << 4);

					sumi += dotPacked4x8EXT(lo_vals, int(xq_packed[wp + w4]));
					sumi += dotPacked4x8EXT(hi_vals, int(xq_packed[wp + 4 + w4]));
				}

				acc[r] = fma(d, float(sumi), acc[r]);
				off[r] = fma(half_to_float(w0_read_u16(block_off + 2u)), s_xq, off[r]);
			}
		}
		barrier();
	}

	for (int r = 0; r < ROWS_PER_THREAD; r++) {
		if (!valid[r])
			continue;
		y[y_off + base_i + uint(r)] =
			(acc[r] + off[r]) + (params.res_mode != 0 ? residual[r_off + base_i + uint(r)] : 0.0);
	}
}

#version 450
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer QAbsBuf {
	float q_abs[];
};
layout(set = 0, binding = 1) readonly buffer CacheBuf {
	float cache[];
};
layout(set = 0, binding = 2) readonly buffer VbBuf {
	float v_b[];
};
layout(set = 0, binding = 3) writeonly buffer OutBuf {
	float ho[];
};

layout(push_constant) uniform Params {
	int	  n_pos;
	int	  kv_lora;
	int	  v_head;
	float scale;
}
params;

const int MAX_LORA		 = 1024;
const int MAX_PER_THREAD = MAX_LORA / 64;

shared float s_qa[MAX_LORA];
shared float s_lat[MAX_LORA];
shared float s_sc[64];

void main() {
	int tid = int(gl_LocalInvocationID.x);
	int h	= int(gl_WorkGroupID.x);
	int R	= params.kv_lora;
	int nr	= (R + 63) / 64;

	for (int r = tid; r < R; r += 64)
		s_qa[r] = q_abs[h * R + r];
	barrier();

	float acc[MAX_PER_THREAD];
	for (int j = 0; j < MAX_PER_THREAD; j++)
		acc[j] = 0.0;
	float m = -1e30;
	float l = 0.0;

	for (int t0 = 0; t0 < params.n_pos; t0 += 64) {
		int	  t = t0 + tid;
		float s = -1e30;
		if (t < params.n_pos) {
			float d = 0.0;
			for (int r = 0; r < R; r++)
				d += s_qa[r] * cache[t * R + r];
			s = d * params.scale;
		}
		s_sc[tid] = s;
		barrier();

		int	  tile = min(64, params.n_pos - t0);
		float tmax = -1e30;
		for (int k = 0; k < tile; k++)
			tmax = max(tmax, s_sc[k]);
		float mnew = max(m, tmax);
		float corr = exp(m - mnew);
		l *= corr;
		for (int j = 0; j < nr; j++)
			acc[j] *= corr;
		for (int k = 0; k < tile; k++) {
			float p = exp(s_sc[k] - mnew);
			l += p;
			int base = (t0 + k) * R;
			for (int j = 0; j < nr; j++) {
				int r = tid + 64 * j;
				if (r < R)
					acc[j] += p * cache[base + r];
			}
		}
		m = mnew;
		barrier();
	}

	for (int j = 0; j < nr; j++) {
		int r = tid + 64 * j;
		if (r < R)
			s_lat[r] = acc[j] / l;
	}
	barrier();

	for (int d = tid; d < params.v_head; d += 64) {
		int	  row = (h * params.v_head + d) * R;
		float s	  = 0.0;
		for (int r = 0; r < R; r++)
			s += v_b[row + r] * s_lat[r];
		ho[h * params.v_head + d] = s;
	}
}

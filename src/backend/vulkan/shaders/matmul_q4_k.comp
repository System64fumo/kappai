#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

layout(local_size_x_id = 0) in;

#ifdef NMAT_DUAL
#define NMAT 2
#else
#define NMAT 1
#endif
layout(constant_id = 2) const int TILE_K = 2048;

#if NMAT >= 2
layout(set = 0, binding = 0) readonly buffer W0Buf { uint w0[]; };
layout(set = 0, binding = 1) readonly buffer W1Buf { uint w1[]; };
layout(set = 0, binding = 2) readonly buffer XBuf  { float x[];  };
layout(set = 0, binding = 3) writeonly buffer Y0Buf { float y0[]; };
layout(set = 0, binding = 4) writeonly buffer Y1Buf { float y1[]; };
#else
layout(set = 0, binding = 0) readonly buffer W0Buf { uint w0[]; };
layout(set = 0, binding = 1) readonly buffer XBuf { float x[]; };
#ifdef HAS_RESIDUAL
layout(set = 0, binding = 2) readonly buffer RBuf { float residual[]; };
layout(set = 0, binding = 3) writeonly buffer Y0Buf { float y0[]; };
#else
layout(set = 0, binding = 2) writeonly buffer Y0Buf { float y0[]; };
#endif
#endif

layout(push_constant) uniform Params {
    int n0;
    int n1;
    int k;
} params;

#include "common.glsl"

#define W_NAME w0
#define W_PFX w0_
#include "weight_io.glsl"
#undef W_NAME
#undef W_PFX

#if NMAT >= 2
#define W_NAME w1
#define W_PFX w1_
#include "weight_io.glsl"
#undef W_NAME
#undef W_PFX
#endif

const int BLOCK = 256;
const int BLOCKS_PER_TILE = TILE_K / BLOCK;

shared float x_shared[TILE_K];
shared int   xq_shared[TILE_K];
shared float xq_d[BLOCKS_PER_TILE];
shared int   xq_bsums[BLOCKS_PER_TILE * 16];

void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationID.x;
    int  k   = params.k;

    int blocks_per_row = k / 256;

    precise float acc0 = 0.0;
    bool valid0 = (int(i) < params.n0);

#if NMAT >= 2
    precise float acc1 = 0.0;
    bool valid1 = (int(i) < params.n1);
#endif

    for (int tile_start = 0; tile_start < k; tile_start += TILE_K) {
        int tile_end = min(tile_start + TILE_K, k);
        int tile_len = tile_end - tile_start;

        for (int j = int(tid); j < tile_len; j += int(gl_WorkGroupSize.x)) {
            x_shared[j] = x[tile_start + j];
        }
        barrier();

        int block_start = tile_start / 256;
        int block_end   = tile_end / 256;

        for (int bi = block_start + int(tid); bi < block_end; bi += int(gl_WorkGroupSize.x)) {
            int x_base = bi * 256 - tile_start;
            float maxv = 0.0, amax = 0.0;
            for (int j = 0; j < 256; j++) {
                float ax = abs(x_shared[x_base + j]);
                if (ax > amax) { amax = ax; maxv = x_shared[x_base + j]; }
            }
            int local_bi = bi - block_start;
            if (amax == 0.0) {
                xq_d[local_bi] = 0.0;
                for (int j = 0; j < 256; j++) xq_shared[x_base + j] = 0;
                for (int j = 0; j < 16; j++) xq_bsums[local_bi * 16 + j] = 0;
            } else {
                float iscale = -127.0 / maxv;
                for (int j = 0; j < 256; j++) {
                    int v = nearest_int(iscale * x_shared[x_base + j]);
                    if (v > 127) v = 127;
                    xq_shared[x_base + j] = v;
                }
                for (int j = 0; j < 16; j++) {
                    int sum = 0;
                    for (int ii = 0; ii < 16; ii++)
                        sum += xq_shared[x_base + j * 16 + ii];
                    xq_bsums[local_bi * 16 + j] = sum;
                }
                xq_d[local_bi] = 1.0 / iscale;
            }
        }
        barrier();

        if (valid0) {
            uint row_off = i * uint(blocks_per_row) * Q4_K_BLOCK_BYTES;

            for (int bi = block_start; bi < block_end; bi++) {
                uint block_off = row_off + uint(bi) * Q4_K_BLOCK_BYTES;
                float d    = half_to_float(w0_read_u16(block_off + 0u));
                float dmin = half_to_float(w0_read_u16(block_off + 2u));

                int local_bi = bi - block_start;
                int x_base = bi * 256 - tile_start;
                float xd = xq_d[local_bi];

                int sumi = 0, summ = 0;
                uint s_off = block_off + 4u;
                uint q_off = block_off + 16u;
                int ib = local_bi * 16;
                int is = 0;
                for (int g = 0; g < 4; g++) {
                    uint sc0_u, m0_u, sc1_u, m1_u;
                    w0_get_scale_min_k4(s_off, is + 0, sc0_u, m0_u);
                    w0_get_scale_min_k4(s_off, is + 1, sc1_u, m1_u);
                    int s0 = int(sc0_u), m0 = int(m0_u);
                    int s1 = int(sc1_u), m1 = int(m1_u);

                    int dot0 = 0, dot1 = 0;
                    for (int l = 0; l < 32; l += 4) {
                        uint word = w0_read_u32(q_off + uint(g * 32 + l));
                        int lo_nibbles = int(word & 0x0F0F0F0Fu);
                        int hi_nibbles = int((word >> 4) & 0x0F0F0F0Fu);

                        int xq_word0 = pack32(i8vec4(int8_t(xq_shared[x_base + g * 64 + l]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 1]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 2]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 3])));
                        int xq_word1 = pack32(i8vec4(int8_t(xq_shared[x_base + g * 64 + l + 32]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 33]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 34]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 35])));

                        dot0 += dotPacked4x8EXT(lo_nibbles, xq_word0);
                        dot1 += dotPacked4x8EXT(hi_nibbles, xq_word1);
                    }
                    sumi += s0 * dot0 + s1 * dot1;
                    summ += m0 * (xq_bsums[ib] + xq_bsums[ib+1]); ib += 2;
                    summ += m1 * (xq_bsums[ib] + xq_bsums[ib+1]); ib += 2;
                    is += 2;
                }
                acc0 += xd * (d * float(sumi) - dmin * float(summ));
            }
        }

#if NMAT >= 2
        if (valid1) {
            uint row_off = i * uint(blocks_per_row) * Q4_K_BLOCK_BYTES;
            for (int bi = block_start; bi < block_end; bi++) {
                uint block_off = row_off + uint(bi) * Q4_K_BLOCK_BYTES;
                float d    = half_to_float(w1_read_u16(block_off + 0u));
                float dmin = half_to_float(w1_read_u16(block_off + 2u));

                int local_bi = bi - block_start;
                int x_base = bi * 256 - tile_start;
                float xd = xq_d[local_bi];

                int sumi = 0, summ = 0;
                uint s_off = block_off + 4u;
                uint q_off = block_off + 16u;
                int ib = local_bi * 16;
                int is = 0;
                for (int g = 0; g < 4; g++) {
                    uint sc0_u, m0_u, sc1_u, m1_u;
                    w1_get_scale_min_k4(s_off, is + 0, sc0_u, m0_u);
                    w1_get_scale_min_k4(s_off, is + 1, sc1_u, m1_u);
                    int s0 = int(sc0_u), m0 = int(m0_u);
                    int s1 = int(sc1_u), m1 = int(m1_u);

                    int dot0 = 0, dot1 = 0;
                    for (int l = 0; l < 32; l += 4) {
                        uint word = w1_read_u32(q_off + uint(g * 32 + l));
                        int lo_nibbles = int(word & 0x0F0F0F0Fu);
                        int hi_nibbles = int((word >> 4) & 0x0F0F0F0Fu);

                        int xq_word0 = pack32(i8vec4(int8_t(xq_shared[x_base + g * 64 + l]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 1]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 2]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 3])));
                        int xq_word1 = pack32(i8vec4(int8_t(xq_shared[x_base + g * 64 + l + 32]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 33]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 34]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 35])));

                        dot0 += dotPacked4x8EXT(lo_nibbles, xq_word0);
                        dot1 += dotPacked4x8EXT(hi_nibbles, xq_word1);
                    }
                    sumi += s0 * dot0 + s1 * dot1;
                    summ += m0 * (xq_bsums[ib] + xq_bsums[ib+1]); ib += 2;
                    summ += m1 * (xq_bsums[ib] + xq_bsums[ib+1]); ib += 2;
                    is += 2;
                }
                acc1 += xd * (d * float(sumi) - dmin * float(summ));
            }
        }
#endif
        barrier();
    }

#if NMAT >= 2
    if (valid0) y0[i] = acc0;
    if (valid1) y1[i] = acc1;
#elif defined(HAS_RESIDUAL)
    if (valid0) y0[i] = acc0 + residual[i];
#else
    if (valid0) y0[i] = acc0;
#endif
}

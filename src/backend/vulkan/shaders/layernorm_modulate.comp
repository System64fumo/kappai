#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer XBuf {
	float x[];
};
layout(set = 0, binding = 1) readonly buffer ScaleBuf {
	float scale[];
};
layout(set = 0, binding = 2) writeonly buffer YBuf {
	float y[];
};

layout(push_constant) uniform Params {
	int	  dim;
	int	  rows;
	float eps;
}
params;

shared float red[256];

float reduce_sum(float v) {
	uint tid = gl_LocalInvocationID.x;
	red[tid] = v;
	barrier();
	for (uint s = 128u; s > 0u; s >>= 1u) {
		if (tid < s)
			red[tid] += red[tid + s];
		barrier();
	}
	float total = red[0];
	barrier();
	return total;
}

void main() {
	uint row = gl_WorkGroupID.x;
	uint tid = gl_LocalInvocationID.x;
	uint dim = uint(params.dim);
	uint off = row * dim;

	float sum = 0.0;
	for (uint i = tid; i < dim; i += 256u)
		sum += x[off + i];
	float mean = reduce_sum(sum) / float(dim);

	float sq = 0.0;
	for (uint i = tid; i < dim; i += 256u) {
		float d = x[off + i] - mean;
		sq += d * d;
	}
	float inv = 1.0 / sqrt(reduce_sum(sq) / float(dim) + params.eps);

	for (uint i = tid; i < dim; i += 256u)
		y[off + i] = (x[off + i] - mean) * inv * (1.0 + scale[i]);
}

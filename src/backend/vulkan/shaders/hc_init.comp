#version 450
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer XBuf {
	float x[];
};
layout(set = 0, binding = 1) writeonly buffer HcBuf {
	float hc[];
};

layout(push_constant) uniform Params {
	int dim;
	int total;
}
params;

void main() {
	int i = int(gl_GlobalInvocationID.x);
	if (i >= params.total)
		return;
	hc[i] = x[i % params.dim];
}

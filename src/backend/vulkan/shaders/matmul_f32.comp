#version 450
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly restrict buffer WBuf {
	float w[];
};
layout(set = 0, binding = 1) readonly restrict buffer XBuf {
	float x[];
};
#ifdef HAS_RESIDUAL
layout(set = 0, binding = 2) readonly restrict buffer RBuf {
	float residual[];
};
layout(set = 0, binding = 3) writeonly restrict buffer YBuf {
	float y[];
};
#else
layout(set = 0, binding = 2) writeonly restrict buffer YBuf {
	float y[];
};
#endif

layout(push_constant) uniform Params {
	int n;
	int k;
	int m;
}
params;

layout(constant_id = 1) const int ROWS_PER_THREAD = 4;
layout(constant_id = 2) const int TILE_K		  = 2048;
layout(constant_id = 3) const int M_PER_WG		  = 4;

shared float x_shared[M_PER_WG][TILE_K];

void main() {
	const int n = params.n;
	const int k = params.k;
	const int m = params.m;
	if (n <= 0)
		return;

	const uint tid	  = gl_LocalInvocationID.x;
	const uint wgsize = gl_WorkGroupSize.x;
	const uint base_i = gl_GlobalInvocationID.x * uint(ROWS_PER_THREAD);

	const int row_start = int(gl_WorkGroupID.y) * M_PER_WG;
	const int rows_here = min(M_PER_WG, m - row_start);

	uint row_off[ROWS_PER_THREAD];
	bool valid[ROWS_PER_THREAD];
	for (int r = 0; r < ROWS_PER_THREAD; ++r) {
		const uint idx = base_i + uint(r);
		valid[r]	   = idx < uint(n);
		row_off[r]	   = min(idx, uint(n) - 1u) * uint(k);
	}

	float acc[M_PER_WG][ROWS_PER_THREAD];
	for (int mr = 0; mr < M_PER_WG; ++mr)
		for (int r = 0; r < ROWS_PER_THREAD; ++r)
			acc[mr][r] = 0.0;

	for (int tile_start = 0; tile_start < k; tile_start += TILE_K) {
		const int  tile_end = min(tile_start + TILE_K, k);
		const int  tile_len = tile_end - tile_start;
		const uint tile_off = uint(tile_start);

		for (int mr = 0; mr < rows_here; ++mr) {
			const uint x_off = uint(row_start + mr) * uint(k);
			for (int j = int(tid); j < tile_len; j += int(wgsize))
				x_shared[mr][j] = x[x_off + tile_off + uint(j)];
		}
		barrier();

		int j = 0;
		for (; j + 4 <= tile_len; j += 4) {
			float wv0[ROWS_PER_THREAD];
			float wv1[ROWS_PER_THREAD];
			float wv2[ROWS_PER_THREAD];
			float wv3[ROWS_PER_THREAD];
			for (int r = 0; r < ROWS_PER_THREAD; ++r) {
				const uint off = row_off[r] + tile_off + uint(j);
				wv0[r]		   = w[off + 0u];
				wv1[r]		   = w[off + 1u];
				wv2[r]		   = w[off + 2u];
				wv3[r]		   = w[off + 3u];
			}
			for (int mr = 0; mr < rows_here; ++mr) {
				const float x0 = x_shared[mr][j + 0];
				const float x1 = x_shared[mr][j + 1];
				const float x2 = x_shared[mr][j + 2];
				const float x3 = x_shared[mr][j + 3];
				for (int r = 0; r < ROWS_PER_THREAD; ++r) {
					acc[mr][r] += wv0[r] * x0;
					acc[mr][r] += wv1[r] * x1;
					acc[mr][r] += wv2[r] * x2;
					acc[mr][r] += wv3[r] * x3;
				}
			}
		}
		for (; j < tile_len; ++j) {
			float wv[ROWS_PER_THREAD];
			for (int r = 0; r < ROWS_PER_THREAD; ++r)
				wv[r] = w[row_off[r] + tile_off + uint(j)];
			for (int mr = 0; mr < rows_here; ++mr) {
				const float xv = x_shared[mr][j];
				for (int r = 0; r < ROWS_PER_THREAD; ++r)
					acc[mr][r] += wv[r] * xv;
			}
		}
		barrier();
	}

	for (int mr = 0; mr < rows_here; ++mr) {
		const uint y_off = uint(row_start + mr) * uint(n);
		for (int r = 0; r < ROWS_PER_THREAD; ++r) {
			if (!valid[r])
				continue;
			const uint o = y_off + base_i + uint(r);
#ifdef HAS_RESIDUAL
			y[o] = acc[mr][r] + residual[o];
#else
			y[o] = acc[mr][r];
#endif
		}
	}
}

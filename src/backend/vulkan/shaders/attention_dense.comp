#version 450
layout(local_size_x = 128) in;

layout(set = 0, binding = 0) readonly buffer QBuf {
	float q[];
};
layout(set = 0, binding = 1) readonly buffer K0Buf {
	float k0[];
};
layout(set = 0, binding = 2) readonly buffer V0Buf {
	float v0[];
};
layout(set = 0, binding = 3) readonly buffer K1Buf {
	float k1[];
};
layout(set = 0, binding = 4) readonly buffer V1Buf {
	float v1[];
};
layout(set = 0, binding = 5) writeonly buffer OutBuf {
	float out_[];
};

layout(push_constant) uniform Params {
	int n_q;
	int n_heads;
	int head_dim;
	int n0;
	int n1;
	int causal;
}
params;

#define TILE 128
#define DC 16
#define KPAD 17
#define MAX_DIMS_PER_THREAD 16
#define NEG_BIG (-3.0e38)

shared float k_tile[TILE * KPAD];
shared vec4	 qs[DC];
shared vec4	 sp[TILE];
shared vec4	 sr[TILE];

float key_at(uint j, uint stride, uint head_off, uint d) {
	uint n0 = uint(params.n0);
	return j < n0 ? k0[j * stride + head_off + d] : k1[(j - n0) * stride + head_off + d];
}

float value_at(uint j, uint stride, uint head_off, uint d) {
	uint n0 = uint(params.n0);
	return j < n0 ? v0[j * stride + head_off + d] : v1[(j - n0) * stride + head_off + d];
}

void main() {
	uint  tid	   = gl_LocalInvocationID.x;
	uint  dims	   = uint(params.head_dim);
	uint  heads	   = uint(params.n_heads);
	uint  n_q	   = uint(params.n_q);
	uint  groups   = (n_q + 3u) / 4u;
	uint  h		   = gl_WorkGroupID.x / groups;
	uint  q0	   = (gl_WorkGroupID.x - h * groups) * 4u;
	uint  stride   = heads * dims;
	uint  head_off = h * dims;
	uint  total	   = uint(params.n0 + params.n1);
	float scale	   = 1.0 / sqrt(float(dims));

	uint  last	= n_q - 1u;
	uvec4 qi	= uvec4(min(q0, last), min(q0 + 1u, last), min(q0 + 2u, last), min(q0 + 3u, last));
	uvec4 qbase = qi * stride + head_off;
	uvec4 vis	= params.causal != 0 ? qi + 1u : uvec4(total);
	uint  vis_max = vis.w;

	vec4 acc[MAX_DIMS_PER_THREAD];
	for (int e = 0; e < MAX_DIMS_PER_THREAD; e++)
		acc[e] = vec4(0.0);
	vec4 run_max = vec4(NEG_BIG);
	vec4 run_sum = vec4(0.0);

	for (uint base = 0u; base < vis_max; base += uint(TILE)) {
		uint j	= base + tid;
		vec4 s4 = vec4(0.0);
		for (uint d0 = 0u; d0 < dims; d0 += uint(DC)) {
			if (tid < uint(DC)) {
				uint d	= d0 + tid;
				vec4 qv = vec4(0.0);
				if (d < dims)
					qv = vec4(q[qbase.x + d], q[qbase.y + d], q[qbase.z + d], q[qbase.w + d]);
				qs[tid] = qv;
			}
			for (uint r = 0u; r < uint(DC); r++) {
				uint  idx = tid + r * uint(TILE);
				uint  t	  = idx / uint(DC);
				uint  dd  = idx % uint(DC);
				uint  jj  = base + t;
				uint  d	  = d0 + dd;
				float kv  = 0.0;
				if (jj < vis_max && d < dims)
					kv = key_at(jj, stride, head_off, d);
				k_tile[t * uint(KPAD) + dd] = kv;
			}
			barrier();
			if (j < vis_max) {
				for (uint dd = 0u; dd < uint(DC); dd++)
					s4 += qs[dd] * k_tile[tid * uint(KPAD) + dd];
			}
			barrier();
		}

		bvec4 live = lessThan(uvec4(j), vis);
		vec4  sv   = mix(vec4(NEG_BIG), s4 * scale, live);
		sr[tid]	   = sv;
		barrier();
		for (uint off = uint(TILE) / 2u; off > 0u; off >>= 1u) {
			if (tid < off)
				sr[tid] = max(sr[tid], sr[tid + off]);
			barrier();
		}
		vec4 new_max = max(run_max, sr[0]);
		barrier();

		vec4 alpha = exp(run_max - new_max);
		vec4 p	   = mix(vec4(0.0), exp(sv - new_max), live);
		sp[tid]	   = p;
		sr[tid]	   = p;
		barrier();
		for (uint off = uint(TILE) / 2u; off > 0u; off >>= 1u) {
			if (tid < off)
				sr[tid] += sr[tid + off];
			barrier();
		}
		run_sum = run_sum * alpha + sr[0];
		run_max = new_max;

		uint count = min(uint(TILE), vis_max - base);
		for (uint e = 0u; e < uint(MAX_DIMS_PER_THREAD); e++) {
			uint d = tid + e * uint(TILE);
			if (d < dims) {
				vec4 c = acc[e] * alpha;
				for (uint t = 0u; t < count; t++)
					c += sp[t] * value_at(base + t, stride, head_off, d);
				acc[e] = c;
			}
		}
		barrier();
	}

	for (uint e = 0u; e < uint(MAX_DIMS_PER_THREAD); e++) {
		uint d = tid + e * uint(TILE);
		if (d < dims) {
			vec4 r			  = acc[e] / run_sum;
			out_[qbase.x + d] = r.x;
			if (q0 + 1u < n_q)
				out_[qbase.y + d] = r.y;
			if (q0 + 2u < n_q)
				out_[qbase.z + d] = r.z;
			if (q0 + 3u < n_q)
				out_[qbase.w + d] = r.w;
		}
	}
}

#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer W0Buf { uint w0[]; };
layout(set = 0, binding = 1) readonly buffer XBuf { float x[]; };
#ifdef HAS_RESIDUAL
layout(set = 0, binding = 2) readonly buffer RBuf { float residual[]; };
layout(set = 0, binding = 3) writeonly buffer YBuf { float y[]; };
#else
layout(set = 0, binding = 2) writeonly buffer YBuf { float y[]; };
#endif

layout(push_constant) uniform Params {
    int n;
    int k;
#ifdef BATCHED
    int m;
#endif
} params;

layout(constant_id = 1) const int ROWS_PER_THREAD = 4;
layout(constant_id = 2) const int TILE_K = 2048;

#include "common.glsl"

#define W_NAME w0
#define W_PFX w0_
#include "weight_io.glsl"
#undef W_NAME
#undef W_PFX

shared float x_shared[TILE_K];
shared int   xq_shared[TILE_K];
shared float xq_d[TILE_K / 32];
shared int   xq_sum[TILE_K / 32];

void main() {
    uint base_i = gl_GlobalInvocationID.x * uint(ROWS_PER_THREAD);
    uint tid = gl_LocalInvocationID.x;
    int  k   = params.k;
    int  blocks_per_row = k / 32;

#ifdef BATCHED
    uint row = gl_WorkGroupID.y;
    uint x_off = row * uint(k);
    uint y_off = row * uint(params.n);
#ifdef HAS_RESIDUAL
    uint r_off = y_off;
#endif
#else
    const uint x_off = 0u;
    const uint y_off = 0u;
#ifdef HAS_RESIDUAL
    const uint r_off = 0u;
#endif
#endif

    precise float acc[ROWS_PER_THREAD];
    for (int r = 0; r < ROWS_PER_THREAD; r++) acc[r] = 0.0;
    bool valid[ROWS_PER_THREAD];
    for (int r = 0; r < ROWS_PER_THREAD; r++)
        valid[r] = (int(base_i) + r < params.n);

    for (int tile_start = 0; tile_start < k; tile_start += TILE_K) {
        int tile_end = min(tile_start + TILE_K, k);
        int tile_len = tile_end - tile_start;

        for (int j = int(tid); j < tile_len; j += int(gl_WorkGroupSize.x))
            x_shared[j] = x[x_off + uint(tile_start + j)];
        barrier();

        int block_start = tile_start / 32;
        int block_end   = tile_end / 32;

        for (int bi = block_start + int(tid); bi < block_end; bi += int(gl_WorkGroupSize.x)) {
            int x_base = bi * 32 - tile_start;
            float amax = 0.0;
            for (int j = 0; j < 32; j++) {
                float ax = abs(x_shared[x_base + j]);
                if (ax > amax) amax = ax;
            }
            float d = amax / 127.0;
            float id = d > 0.0 ? 1.0 / d : 0.0;
            xq_d[bi - block_start] = f32_to_f16_to_f32(d);
            int sum = 0;
            for (int j = 0; j < 32; j++) {
                int q = round_away(x_shared[x_base + j] * id);
                if (q > 127) q = 127;
                if (q < -128) q = -128;
                xq_shared[x_base + j] = q;
                sum += q;
            }
            xq_sum[bi - block_start] = sum;
        }
        barrier();

        for (int bi = block_start; bi < block_end; bi++) {
            int x_base = bi * 32 - tile_start;
            float d_xq = xq_d[bi - block_start];
            int   xsum = xq_sum[bi - block_start];

            int xq_words[4];
            int xq_words_hi[4];
            for (int w4 = 0; w4 < 4; w4++) {
                int j = w4 * 4;
                uint lo_word = 0u;
                uint hi_word = 0u;
                for (int b = 0; b < 4; b++) {
                    lo_word |= (uint(xq_shared[x_base + j + b]) & 0xFFu) << uint(b * 8);
                    hi_word |= (uint(xq_shared[x_base + j + 16 + b]) & 0xFFu) << uint(b * 8);
                }
                xq_words[w4] = int(lo_word);
                xq_words_hi[w4] = int(hi_word);
            }

            for (int r = 0; r < ROWS_PER_THREAD; r++) {
                if (!valid[r]) continue;
                uint row_idx = base_i + uint(r);
                uint block_off = row_idx * uint(blocks_per_row) * Q5_0_BLOCK_BYTES
                               + uint(bi) * Q5_0_BLOCK_BYTES;

                float d = half_to_float(w0_read_u16(block_off)) * d_xq;
                uint qh = w0_read_u32(block_off + 2u);
                uint qs_off = block_off + 6u;

                int sumi = 0;
                for (int w4 = 0; w4 < 4; w4++) {
                    uint word = w0_read_u32(qs_off + uint(w4 * 4));
                    int j = w4 * 4;

                    uint lo_word = 0u;
                    uint hi_word = 0u;
                    for (int b = 0; b < 4; b++) {
                        uint byte = (word >> uint(b * 8)) & 0xFFu;
                        int lo4 = int(byte & 0xFu);
                        int hi4 = int(byte >> 4u);
                        int lo_bit = int((qh >> uint(j + b)) & 1u);
                        int hi_bit = int((qh >> uint(j + b + 16)) & 1u);
                        uint lo_val = uint((lo4 | (lo_bit << 4)) - 16) & 0xFFu;
                        uint hi_val = uint((hi4 | (hi_bit << 4)) - 16) & 0xFFu;
                        lo_word |= lo_val << uint(b * 8);
                        hi_word |= hi_val << uint(b * 8);
                    }

                    sumi += dotPacked4x8EXT(int(lo_word), xq_words[w4]);
                    sumi += dotPacked4x8EXT(int(hi_word), xq_words_hi[w4]);
                }

                acc[r] = fma(d, float(sumi), acc[r]);
            }
        }
        barrier();
    }

    for (int r = 0; r < ROWS_PER_THREAD; r++) {
        if (!valid[r]) continue;
#ifdef HAS_RESIDUAL
        y[y_off + base_i + uint(r)] = acc[r] + residual[r_off + base_i + uint(r)];
#else
        y[y_off + base_i + uint(r)] = acc[r];
#endif
    }
}
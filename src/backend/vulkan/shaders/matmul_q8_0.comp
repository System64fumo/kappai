#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer W0Buf {
	uint w0[];
};
layout(set = 0, binding = 1) readonly buffer XBuf {
	float x[];
};
#ifdef HAS_RESIDUAL
layout(set = 0, binding = 2) readonly buffer RBuf {
	float residual[];
};
layout(set = 0, binding = 3) writeonly buffer YBuf {
	float y[];
};
#else
layout(set = 0, binding = 2) writeonly buffer YBuf {
	float y[];
};
#endif

layout(push_constant) uniform Params {
	int n;
	int k;
	int m;
}
params;

layout(constant_id = 1) const int ROWS_PER_THREAD = 4;
layout(constant_id = 2) const int TILE_K		  = 2048;

#include "common.glsl"

#define W_NAME w0
#define W_PFX w0_
#include "weight_io.glsl"
#undef W_NAME
#undef W_PFX

shared float x_shared[TILE_K];
shared float dx_scale_shared[TILE_K / 32];
shared uint	 xq_packed[TILE_K / 4];

#include "xq8_block.glsl"

void main() {
	uint base_i			= gl_GlobalInvocationID.x * uint(ROWS_PER_THREAD);
	uint tid			= gl_LocalInvocationID.x;
	int	 k				= params.k;
	int	 blocks_per_row = k / 32;

	uint row   = gl_WorkGroupID.y;
	uint x_off = row * uint(k);
	uint y_off = row * uint(params.n);
#ifdef HAS_RESIDUAL
	uint r_off = y_off;
#endif

	precise float acc[ROWS_PER_THREAD];
	for (int r = 0; r < ROWS_PER_THREAD; r++)
		acc[r] = 0.0;
	bool valid[ROWS_PER_THREAD];
	for (int r = 0; r < ROWS_PER_THREAD; r++)
		valid[r] = (int(base_i) + r < params.n);

	for (int tile_start = 0; tile_start < k; tile_start += TILE_K) {
		int tile_end = min(tile_start + TILE_K, k);
		int tile_len = tile_end - tile_start;

		for (int j = int(tid); j < tile_len; j += int(gl_WorkGroupSize.x))
			x_shared[j] = x[x_off + uint(tile_start + j)];
		barrier();

		int local_blocks = tile_len / 32;
		for (int local_bi = int(tid); local_bi < local_blocks;
			 local_bi += int(gl_WorkGroupSize.x)) {
			float dx;
			xq8_quant_block(local_bi * 32, dx);
			dx_scale_shared[local_bi] = half_to_float(float_to_half(dx));
		}
		barrier();

		for (int local_bi = 0; local_bi < local_blocks; local_bi++) {
			int	  bi	   = tile_start / 32 + local_bi;
			float dx_scale = dx_scale_shared[local_bi];

			int wp = local_bi * 8;
			for (int r = 0; r < ROWS_PER_THREAD; r++) {
				if (!valid[r])
					continue;
				uint row_idx = base_i + uint(r);
				uint block_off =
					row_idx * uint(blocks_per_row) * Q8_0_BLOCK_BYTES + uint(bi) * Q8_0_BLOCK_BYTES;
				float d		 = half_to_float(w0_read_u16(block_off));
				uint  qs_off = block_off + 2u;

				int sumi = 0;
				for (int w4 = 0; w4 < 8; w4++) {
					int qv = int(w0_read_u32(qs_off + uint(w4 * 4)));
					sumi += dotPacked4x8EXT(qv, int(xq_packed[wp + w4]));
				}
				acc[r] = fma(d * dx_scale, float(sumi), acc[r]);
			}
		}
		barrier();
	}

	for (int r = 0; r < ROWS_PER_THREAD; r++) {
		if (!valid[r])
			continue;
#ifdef HAS_RESIDUAL
		y[y_off + base_i + uint(r)] = acc[r] + residual[r_off + base_i + uint(r)];
#else
		y[y_off + base_i + uint(r)] = acc[r];
#endif
	}
}

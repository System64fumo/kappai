#version 450
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer FusedBuf {
	float fused[];
};
layout(set = 0, binding = 1) writeonly buffer OutBuf {
	float out_[];
};

layout(push_constant) uniform Params {
	int n;
	int activation;
	int m;
}
params;

#include "common.glsl"

void main() {
	uint row = gl_WorkGroupID.y;
	if (row >= uint(params.m))
		return;
	uint i = gl_GlobalInvocationID.x;
	if (int(i) >= params.n)
		return;
	uint  n			  = uint(params.n);
	uint  row_off	  = row * n * 2u;
	float g			  = fused[row_off + i];
	float u			  = fused[row_off + n + i];
	float activated	  = params.activation == 1 ? gelu_tanh(g) : silu(g);
	out_[row * n + i] = activated * u;
}

#version 450
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer GateBuf {
	float gate[];
};
layout(set = 0, binding = 1) readonly buffer UpBuf {
	float up[];
};
layout(set = 0, binding = 2) writeonly buffer OutBuf {
	float out_[];
};

layout(push_constant) uniform Params {
	int	  n;
	int	  activation;
	int	  m;
	float gs;
	float us;
}
params;

#include "common.glsl"

void main() {
	uint row = gl_WorkGroupID.y;
	if (row >= uint(params.m))
		return;
	uint row_off = row * uint(params.n);
	uint i		 = gl_GlobalInvocationID.x;
	if (int(i) >= params.n)
		return;
	float g			  = gate[row_off + i] * params.gs;
	float u			  = up[row_off + i] * params.us;
	float activated	  = params.activation == 1 ? gelu_tanh(g) : silu(g);
	out_[row_off + i] = activated * u;
}

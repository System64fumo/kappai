#version 450

#ifdef USE_SUBGROUP
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#endif

layout(local_size_x = 256, local_size_x_id = 0) in;
#if defined(PER_HEAD) && defined(USE_SUBGROUP)
layout(constant_id = 1) const bool PACK_HEADS = false;
#endif

layout(set = 0, binding = 0) readonly buffer XBuf {
	float x[];
};

#ifdef HAS_WEIGHT
layout(set = 0, binding = 1) readonly buffer WBuf {
	float w[];
};
#ifdef ADD_RESIDUAL
layout(set = 0, binding = 2) readonly buffer RBuf {
	float residual[];
};
layout(set = 0, binding = 3) writeonly buffer YBuf {
	float y[];
};
#else
layout(set = 0, binding = 2) writeonly buffer YBuf {
	float y[];
};
#endif
#else
#ifdef ADD_RESIDUAL
layout(set = 0, binding = 1) readonly buffer RBuf {
	float residual[];
};
layout(set = 0, binding = 2) writeonly buffer YBuf {
	float y[];
};
#else
layout(set = 0, binding = 1) writeonly buffer YBuf {
	float y[];
};
#endif
#endif

#ifdef NORM2
layout(set = 0, binding = 4) readonly buffer W2Buf {
	float w2[];
};
layout(set = 0, binding = 5) writeonly buffer Y2Buf {
	float y2[];
};
#define XQ_BINDING 6
#else
#define XQ_BINDING 3
#endif

#ifdef QUANT_OUT
layout(set = 0, binding = XQ_BINDING) writeonly buffer XQBuf {
	uint xq[];
};
#include "common.glsl"
#define QUANT_MAX_N 4096
shared float s_y[QUANT_MAX_N];
#endif

#ifdef PER_HEAD
layout(push_constant) uniform Params {
	int	  n_heads;
	int	  head_dim;
	float eps;
	int	  m;
}
params;
#else
layout(push_constant) uniform Params {
	int	  n;
	float eps;
	int	  m;
#ifdef ADD_RESIDUAL
	float os;
#endif
}
params;
#endif

#ifdef USE_SUBGROUP
shared float sg_partial[256];
#else
shared float partial[256];
#endif

float block_sum(float sum) {
#if defined(PER_HEAD) && defined(USE_SUBGROUP)
	if (PACK_HEADS)
		return subgroupAdd(sum);
#endif
	uint tid = gl_LocalInvocationID.x;
	barrier();
#ifdef USE_SUBGROUP
	sum = subgroupAdd(sum);
	if (gl_NumSubgroups > 1) {
		if (gl_SubgroupInvocationID == 0) {
			sg_partial[gl_SubgroupID] = sum;
		}
		barrier();
		if (gl_SubgroupID == 0) {
			uint  n_sg = gl_NumSubgroups;
			float sg_sum =
				(gl_SubgroupInvocationID < n_sg) ? sg_partial[gl_SubgroupInvocationID] : 0.0;
			sg_sum = subgroupAdd(sg_sum);
			if (gl_SubgroupInvocationID == 0) {
				sg_partial[0] = sg_sum;
			}
		}
		barrier();
		sum = sg_partial[0];
	}
#else
	partial[tid] = sum;
	barrier();
	for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1u) {
		if (tid < stride)
			partial[tid] += partial[tid + stride];
		barrier();
	}
	sum = partial[0];
#endif
	return sum;
}

void main() {
	uint tid = gl_LocalInvocationID.x;
	uint step = gl_WorkGroupSize.x;
#if defined(PER_HEAD) && defined(USE_SUBGROUP)
	if (PACK_HEADS) {
		tid	 = gl_SubgroupInvocationID;
		step = gl_SubgroupSize;
	}
#endif

#ifdef PER_HEAD
	int h = int(gl_WorkGroupID.x);
#ifdef USE_SUBGROUP
	if (PACK_HEADS)
		h = int(gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID);
#endif
	if (h >= params.n_heads)
		return;
	int head_dim = params.head_dim;
	int base	 = h * head_dim;
	int n		 = head_dim;
#else
	int n	 = params.n;
	int base = 0;
#endif

#ifdef PER_HEAD
	uint row		= gl_WorkGroupID.y;
	uint row_stride = uint(params.n_heads) * uint(params.head_dim);
	uint x_off		= row * row_stride + uint(base);
	uint y_off		= row * row_stride + uint(base);
#else
	uint row   = gl_WorkGroupID.y;
	uint x_off = row * uint(params.n);
	uint y_off = row * uint(params.n);
#endif

	float sum = 0.0;
	for (int i = int(tid); i < n; i += int(step)) {
		float v = x[x_off + uint(i)];
		sum += v * v;
	}

	sum = block_sum(sum);

	float scale = (sum > 0.0 || params.eps > 0.0) ? inversesqrt(sum / float(n) + params.eps) : 0.0;

#ifdef NORM2
	float sum2 = 0.0;
#endif
	for (int i = int(tid); i < n; i += int(step)) {
		float xv = x[x_off + uint(i)];
		float result;
#ifdef HAS_WEIGHT
		result = xv * scale * w[i];
#else
		result = xv * scale;
#endif
#ifdef ADD_RESIDUAL
		result += residual[x_off + uint(i)];
		result *= params.os;
#endif
		y[y_off + uint(i)] = result;
#ifdef QUANT_OUT
		s_y[i] = result;
#endif
#ifdef NORM2
		sum2 += result * result;
#endif
	}

#ifdef NORM2
	sum2 = block_sum(sum2);
	float scale2 =
		(sum2 > 0.0 || params.eps > 0.0) ? inversesqrt(sum2 / float(n) + params.eps) : 0.0;
	for (int i = int(tid); i < n; i += int(step)) {
		float r2			= s_y[i] * scale2 * w2[i];
		y2[y_off + uint(i)] = r2;
		s_y[i]				= r2;
	}
#endif

#ifdef QUANT_OUT
	barrier();
	uint kb = uint(n) / 32u;
	for (uint b = tid; b < kb; b += 256u) {
		float amax = 0.0;
		for (uint j = 0u; j < 32u; j++)
			amax = max(amax, abs(s_y[b * 32u + j]));
		float d	  = div_exact(amax, 127.0);
		float inv = d > 0.0 ? div_exact(1.0, d) : 0.0;
		uint  dst = (row * kb + b) * 12u;
		int	  sum = 0;
		for (uint wd = 0u; wd < 8u; wd++) {
			uint packed = 0u;
			for (uint j = 0u; j < 4u; j++) {
				int q = clamp(round_away(s_y[b * 32u + wd * 4u + j] * inv), -127, 127);
				sum += q;
				packed |= (uint(q) & 0xFFu) << (8u * j);
			}
			xq[dst + wd] = packed;
		}
		xq[dst + 8u]  = floatBitsToUint(f32_to_f16_to_f32(d));
		xq[dst + 9u]  = floatBitsToUint(f32_to_f16_to_f32(d * float(sum)));
		xq[dst + 10u] = 0u;
		xq[dst + 11u] = 0u;
	}
#endif
}

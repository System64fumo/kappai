#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#define WG 64
#define MAX_SUBGROUPS 16

layout(local_size_x = WG) in;
layout(constant_id = 0) const uint COLS = 1;
layout(constant_id = 1) const uint ROWS = 2;

layout(set = 0, binding = 0) readonly buffer W {
	uint16_t w16[];
};
layout(set = 0, binding = 1) readonly buffer XQ {
	uint xq[];
};
layout(set = 0, binding = 2) buffer Y {
	float y[];
};
layout(set = 0, binding = 3) readonly buffer R {
	float res[];
};

layout(push_constant) uniform Params {
	int n;
	int kb;
	int m;
	int res_mode;
}
pc;

#define W16 w16
#include "qblock.glsl"

shared float s_red[16 * MAX_SUBGROUPS];

void main() {
	qblock_init();
	barrier();

	uint tid  = gl_LocalInvocationID.x;
	uint n	  = uint(pc.n);
	uint m	  = uint(pc.m);
	uint kb	  = uint(pc.kb);
	uint row0 = gl_WorkGroupID.x * ROWS;
	uint col0 = gl_WorkGroupID.y * COLS;

	uint wrow[ROWS];
	for (uint r = 0u; r < ROWS; r++)
		wrow[r] = min(row0 + r, n - 1u) * kb;
	uint xcol[COLS];
	for (uint c = 0u; c < COLS; c++)
		xcol[c] = min(col0 + c, m - 1u) * kb;

	float acc[ROWS * COLS];
	for (uint i = 0u; i < ROWS * COLS; i++)
		acc[i] = 0.0;

	for (uint it = tid; it < kb * 4u; it += WG) {
		uint  bi = it >> 2u;
		uint  pp = it & 3u;
		uint  xa[COLS];
		uint  xb[COLS];
		float dx[COLS];
		float sx[COLS];
		for (uint c = 0u; c < COLS; c++) {
			uint base = (xcol[c] + bi) * XQ_BLOCK_WORDS;
			xa[c]	  = xq[base + XW_A(pp)];
			xb[c]	  = xq[base + XW_B(pp)];
			dx[c]	  = uintBitsToFloat(xq[base + XQ_D_WORD]);
			sx[c]	  = uintBitsToFloat(xq[base + XQ_S_WORD]);
		}
		for (uint r = 0u; r < ROWS; r++) {
			uint  wa, wb;
			float d, mn;
			load_wpart((wrow[r] + bi) * BLOCK_U16, pp, wa, wb, d, mn);
			for (uint c = 0u; c < COLS; c++) {
				int sumi =
					dotPacked4x8EXT(int(wa), int(xa[c])) + dotPacked4x8EXT(int(wb), int(xb[c]));
				float a = acc[r * COLS + c];
#ifdef HAS_MIN
				if (pp == 0u)
					a += mn * sx[c];
#endif
				acc[r * COLS + c] = fma(d * dx[c], float(sumi), a);
			}
		}
	}

	for (uint i = 0u; i < ROWS * COLS; i++) {
		float v = subgroupAdd(acc[i]);
		if (subgroupElect())
			s_red[i * MAX_SUBGROUPS + gl_SubgroupID] = v;
	}
	barrier();
	if (tid >= ROWS * COLS)
		return;
	uint r	 = tid / COLS;
	uint c	 = tid % COLS;
	uint row = row0 + r;
	uint col = col0 + c;
	if (row >= n || col >= m)
		return;
	float v = 0.0;
	for (uint s = 0u; s < gl_NumSubgroups; s++)
		v += s_red[tid * MAX_SUBGROUPS + s];
	uint yi = col * n + row;
	if (pc.res_mode == 1)
		y[yi] = v + res[row];
	else if (pc.res_mode == 2)
		y[yi] += v;
	else
		y[yi] = v;
}

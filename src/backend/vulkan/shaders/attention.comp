#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer QBuf {
	float q[];
};
layout(set = 0, binding = 1) readonly buffer KBuf {
	uint kcache[];
};
layout(set = 0, binding = 2) readonly buffer VBuf {
	uint vcache[];
};
layout(set = 0, binding = 3) buffer ScoresBuf {
	float scores[];
};
layout(set = 0, binding = 4) writeonly buffer OutBuf {
	float out_[];
};

layout(push_constant) uniform Params {
	uint  layer_off;
	int	  pos;
	int	  n_heads;
	int	  n_kv_heads;
	int	  head_dim;
	int	  n_ctx;
	float scale;
	int	  stride_head_dim;
	int	  attn_start;
	int	  kv_q8;
	int	  kv_row_bytes;
#ifdef BATCHED
	int m;
#endif
}
params;

#include "common.glsl"

uint ld8k(uint byte_off) {
	uint w = kcache[byte_off >> 2u];
	return (w >> ((byte_off & 3u) << 3u)) & 0xFFu;
}
uint ld16k(uint byte_off) {
	uint w = kcache[byte_off >> 2u];
	return (w >> ((byte_off & 2u) << 3u)) & 0xFFFFu;
}
uint ld8v(uint byte_off) {
	uint w = vcache[byte_off >> 2u];
	return (w >> ((byte_off & 3u) << 3u)) & 0xFFu;
}
uint ld16v(uint byte_off) {
	uint w = vcache[byte_off >> 2u];
	return (w >> ((byte_off & 2u) << 3u)) & 0xFFFFu;
}

layout(constant_id = 0) const int MAX_HEAD_DIM = 256;
layout(constant_id = 1) const int TILE_T	   = 16;

shared float	 red[64];
shared float16_t q_shared[MAX_HEAD_DIM];
shared float16_t kv_tile[TILE_T * MAX_HEAD_DIM];

void main() {
	uint h	 = gl_WorkGroupID.x;
	uint tid = gl_LocalInvocationID.x;

	int n_groups = params.n_heads / params.n_kv_heads;
	int kvh		 = int(h) / n_groups;
	int head_dim = params.head_dim;
	int pos		 = params.pos;
	int n_ctx	 = params.n_ctx;

#ifdef BATCHED
	uint row = gl_WorkGroupID.y;
	if (row >= uint(params.m))
		return;
	pos				 = params.pos + int(row);
	uint q_row_off	 = row * uint(params.n_heads) * uint(head_dim);
	uint sc_row_off	 = row * uint(params.n_heads) * uint(n_ctx);
	uint out_row_off = row * uint(params.n_heads) * uint(head_dim);
#else
	const uint row		   = 0u;
	const uint q_row_off   = 0u;
	const uint sc_row_off  = 0u;
	const uint out_row_off = 0u;
#endif

	uint q_base = q_row_off + h * uint(head_dim);
	for (int d = int(tid); d < head_dim; d += 64) {
		q_shared[d] = float16_t(q[q_base + uint(d)]);
	}
	barrier();

	uint row_stride =
		(params.kv_q8 != 0) ? uint(params.kv_row_bytes) : uint(params.stride_head_dim);
	uint kvh_stride = uint(n_ctx) * row_stride;
	uint kv_base	= params.layer_off + uint(kvh) * kvh_stride;

	uint sc_base	= sc_row_off + h * uint(n_ctx);
	int	 attn_start = params.attn_start;

	for (int tile_t0 = attn_start; tile_t0 <= pos; tile_t0 += TILE_T) {
		int tile_t1	 = min(tile_t0 + TILE_T, pos + 1);
		int tile_len = tile_t1 - tile_t0;

		int total_words = tile_len * (head_dim / 2);
		for (int idx = int(tid); idx < total_words; idx += 64) {
			int t  = idx / (head_dim / 2);
			int dw = idx % (head_dim / 2);
			int d0 = dw * 2;
			int d1 = d0 + 1;
			if (params.kv_q8 == 0) {
				uint elem_idx			   = kv_base + uint(tile_t0 + t) * row_stride + uint(d0);
				uint word				   = kcache[elem_idx >> 1u];
				kv_tile[t * head_dim + d0] = float16_t(half_to_float(word & 0xFFFFu));
				kv_tile[t * head_dim + d1] = float16_t(half_to_float(word >> 16u));
			} else {
				uint row_byte = kv_base + uint(tile_t0 + t) * uint(params.kv_row_bytes);
				// dequant d0
				int	  b0	  = d0 >> 5;
				int	  o0	  = d0 & 31;
				uint  soff0	  = row_byte + uint(b0) * 34u;
				float d0scale = unpackHalf2x16(ld16k(soff0)).x;
				int	  q0	  = int(ld8k(soff0 + 2u + uint(o0)));
				if (q0 > 127)
					q0 -= 256;
				kv_tile[t * head_dim + d0] = float16_t(d0scale * float(q0));
				// dequant d1
				int	  b1	  = d1 >> 5;
				int	  o1	  = d1 & 31;
				uint  soff1	  = row_byte + uint(b1) * 34u;
				float d1scale = unpackHalf2x16(ld16k(soff1)).x;
				int	  q1	  = int(ld8k(soff1 + 2u + uint(o1)));
				if (q1 > 127)
					q1 -= 256;
				kv_tile[t * head_dim + d1] = float16_t(d1scale * float(q1));
			}
		}
		barrier();

		for (int t = int(tid); t < tile_len; t += 64) {
			float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
			int	  d		  = 0;
			int	  hd_main = head_dim - (head_dim % 8);
			for (; d < hd_main; d += 8) {
				a0 += float(q_shared[d]) * float(kv_tile[t * head_dim + d]) +
					  float(q_shared[d + 4]) * float(kv_tile[t * head_dim + d + 4]);
				a1 += float(q_shared[d + 1]) * float(kv_tile[t * head_dim + d + 1]) +
					  float(q_shared[d + 5]) * float(kv_tile[t * head_dim + d + 5]);
				a2 += float(q_shared[d + 2]) * float(kv_tile[t * head_dim + d + 2]) +
					  float(q_shared[d + 6]) * float(kv_tile[t * head_dim + d + 6]);
				a3 += float(q_shared[d + 3]) * float(kv_tile[t * head_dim + d + 3]) +
					  float(q_shared[d + 7]) * float(kv_tile[t * head_dim + d + 7]);
			}
			for (; d < head_dim; d++)
				a0 += float(q_shared[d]) * float(kv_tile[t * head_dim + d]);
			float dot							= (a0 + a1) + (a2 + a3);
			scores[sc_base + uint(tile_t0 + t)] = dot * params.scale;
		}
		barrier();
	}

	memoryBarrierBuffer();
	barrier();

	float local_max = uintBitsToFloat(0xFF800000u);
	for (int t = attn_start + int(tid); t <= pos; t += 64) {
		local_max = max(local_max, scores[sc_base + uint(t)]);
	}
	red[tid] = local_max;
	barrier();
	for (uint stride = 32u; stride > 0u; stride >>= 1u) {
		if (tid < stride)
			red[tid] = max(red[tid], red[tid + stride]);
		barrier();
	}
	float mx = red[0];
	barrier();

	float local_sum = 0.0;
	for (int t = attn_start + int(tid); t <= pos; t += 64) {
		float e					  = exp(scores[sc_base + uint(t)] - mx);
		scores[sc_base + uint(t)] = e;
		local_sum += e;
	}
	red[tid] = local_sum;
	barrier();
	for (uint stride = 32u; stride > 0u; stride >>= 1u) {
		if (tid < stride)
			red[tid] += red[tid + stride];
		barrier();
	}
	float inv_sum = red[0] > 0.0 ? 1.0 / red[0] : 0.0;
	barrier();

	for (int d = int(tid); d < head_dim; d += 64) {
		out_[out_row_off + h * uint(head_dim) + uint(d)] = 0.0;
	}

	memoryBarrierBuffer();
	barrier();

	for (int tile_t0 = attn_start; tile_t0 <= pos; tile_t0 += TILE_T) {
		int tile_t1	 = min(tile_t0 + TILE_T, pos + 1);
		int tile_len = tile_t1 - tile_t0;

		int total_words = tile_len * (head_dim / 2);
		for (int idx = int(tid); idx < total_words; idx += 64) {
			int t  = idx / (head_dim / 2);
			int dw = idx % (head_dim / 2);
			int d0 = dw * 2;
			int d1 = d0 + 1;
			if (params.kv_q8 == 0) {
				uint elem_idx			   = kv_base + uint(tile_t0 + t) * row_stride + uint(d0);
				uint word				   = vcache[elem_idx >> 1u];
				kv_tile[t * head_dim + d0] = float16_t(half_to_float(word & 0xFFFFu));
				kv_tile[t * head_dim + d1] = float16_t(half_to_float(word >> 16u));
			} else {
				uint  row_byte = kv_base + uint(tile_t0 + t) * row_stride;
				int	  b0	   = d0 >> 5;
				int	  o0	   = d0 & 31;
				uint  soff0	   = row_byte + uint(b0) * 34u;
				float s0	   = unpackHalf2x16(ld16v(soff0)).x;
				int	  q0	   = int(ld8v(soff0 + 2u + uint(o0)));
				if (q0 > 127)
					q0 -= 256;
				kv_tile[t * head_dim + d0] = float16_t(s0 * float(q0));
				int	  b1				   = d1 >> 5;
				int	  o1				   = d1 & 31;
				uint  soff1				   = row_byte + uint(b1) * 34u;
				float s1				   = unpackHalf2x16(ld16v(soff1)).x;
				int	  q1				   = int(ld8v(soff1 + 2u + uint(o1)));
				if (q1 > 127)
					q1 -= 256;
				kv_tile[t * head_dim + d1] = float16_t(s1 * float(q1));
			}
		}
		barrier();

		for (int d = int(tid); d < head_dim; d += 64) {
			precise float acc = 0.0;
			for (int t = 0; t < tile_len; t++) {
				precise float sv = scores[sc_base + uint(tile_t0 + t)] * inv_sum;
				acc += sv * kv_tile[t * head_dim + d];
			}
			out_[out_row_off + h * uint(head_dim) + uint(d)] += acc;
		}
		barrier();
	}
}

#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer W0Buf { uint w0[]; };
layout(set = 0, binding = 1) readonly buffer XBuf { float x[]; };
#ifdef HAS_RESIDUAL
layout(set = 0, binding = 2) readonly buffer RBuf { float residual[]; };
layout(set = 0, binding = 3) writeonly buffer YBuf { float y[]; };
#else
layout(set = 0, binding = 2) writeonly buffer YBuf { float y[]; };
#endif

layout(push_constant) uniform Params {
    int n;
    int k;
    int m;
} params;

#include "common.glsl"

#define W_NAME w0
#define W_PFX w0_
#include "weight_io.glsl"
#undef W_NAME
#undef W_PFX

layout(constant_id = 2) const int TILE_K = 2048;
const int BLOCK = 256;
const int BLOCKS_PER_TILE = TILE_K / BLOCK;

shared float x_shared[TILE_K];
shared int   xq_shared[TILE_K];
shared float xq_d[BLOCKS_PER_TILE];
shared int   xq_bsums[BLOCKS_PER_TILE * 16];

void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationID.x;
    int  k   = params.k;

    int blocks_per_row = k / 256;
    uint row_stride = uint(blocks_per_row) * Q5_K_BLOCK_BYTES;

    uint row = gl_WorkGroupID.y;
    uint x_off = row * uint(k);
    uint y_off = row * uint(params.n);
#ifdef HAS_RESIDUAL
    uint r_off = y_off;
#endif

    precise float acc = 0.0;
    bool valid = (int(i) < params.n);

    for (int tile_start = 0; tile_start < k; tile_start += TILE_K) {
        int tile_end = min(tile_start + TILE_K, k);
        int tile_len = tile_end - tile_start;

        for (int j = int(tid); j < tile_len; j += int(gl_WorkGroupSize.x)) {
            x_shared[j] = x[x_off + uint(tile_start + j)];
        }
        barrier();

        int block_start = tile_start / 256;
        int block_end   = tile_end / 256;

        for (int bi = block_start + int(tid); bi < block_end; bi += int(gl_WorkGroupSize.x)) {
            int x_base = bi * 256 - tile_start;
            float maxv = 0.0, amax = 0.0;
            for (int j = 0; j < 256; j++) {
                float ax = abs(x_shared[x_base + j]);
                if (ax > amax) { amax = ax; maxv = x_shared[x_base + j]; }
            }
            int local_bi = bi - block_start;
            if (amax == 0.0) {
                xq_d[local_bi] = 0.0;
                for (int j = 0; j < 256; j++) xq_shared[x_base + j] = 0;
                for (int j = 0; j < 16; j++) xq_bsums[local_bi * 16 + j] = 0;
            } else {
                float iscale = -127.0 / maxv;
                for (int j = 0; j < 256; j++) {
                    int v = nearest_int(iscale * x_shared[x_base + j]);
                    if (v > 127) v = 127;
                    if (v < -127) v = -127;
                    xq_shared[x_base + j] = v;
                }
                for (int j = 0; j < 16; j++) {
                    int sum = 0;
                    for (int ii = 0; ii < 16; ii++)
                        sum += xq_shared[x_base + j * 16 + ii];
                    xq_bsums[local_bi * 16 + j] = sum;
                }
                xq_d[local_bi] = 1.0 / iscale;
            }
        }
        barrier();

        if (valid) {
            uint row_off = i * row_stride;

            for (int bi = block_start; bi < block_end; bi++) {
                uint block_off = row_off + uint(bi) * Q5_K_BLOCK_BYTES;
                float d    = half_to_float(w0_read_u16(block_off + 0u));
                float dmin = half_to_float(w0_read_u16(block_off + 2u));

                int local_bi = bi - block_start;
                int x_base = bi * 256 - tile_start;
                float xd = xq_d[local_bi];

                int sumi = 0, summ = 0;
                uint s_off  = block_off + 4u;
                uint qh_off = block_off + 16u;
                uint qs_off = block_off + 48u;
                int ib = local_bi * 16;
                int is = 0;
                for (int g = 0; g < 4; g++) {
                    uint sc0_u, m0_u, sc1_u, m1_u;
                    w0_get_scale_min_k4(s_off, is + 0, sc0_u, m0_u);
                    w0_get_scale_min_k4(s_off, is + 1, sc1_u, m1_u);
                    int s0 = int(sc0_u), m0 = int(m0_u);
                    int s1 = int(sc1_u), m1 = int(m1_u);

                    int dot0 = 0, dot1 = 0;
                    int g_shift = 2 * g;
                    for (int l = 0; l < 32; l += 4) {
                        uint qs_word = w0_read_u32(qs_off + uint(g * 32 + l));
                        uint qh_word = w0_read_u32(qh_off + uint(l));

                        int qb0 = int((qs_word      ) & 0xFFu);
                        int qb1 = int((qs_word >>  8u) & 0xFFu);
                        int qb2 = int((qs_word >> 16u) & 0xFFu);
                        int qb3 = int((qs_word >> 24u) & 0xFFu);

                        int qh0 = int((qh_word      ) & 0xFFu);
                        int qh1 = int((qh_word >>  8u) & 0xFFu);
                        int qh2 = int((qh_word >> 16u) & 0xFFu);
                        int qh3 = int((qh_word >> 24u) & 0xFFu);

                        int lo0 = (qb0 & 0xF) | (int((qh0 >> g_shift) & 1) << 4);
                        int lo1 = (qb1 & 0xF) | (int((qh1 >> g_shift) & 1) << 4);
                        int lo2 = (qb2 & 0xF) | (int((qh2 >> g_shift) & 1) << 4);
                        int lo3 = (qb3 & 0xF) | (int((qh3 >> g_shift) & 1) << 4);
                        int w_lo = pack32(i8vec4(int8_t(lo0), int8_t(lo1),
                                                  int8_t(lo2), int8_t(lo3)));
                        int xq_word0 = pack32(i8vec4(int8_t(xq_shared[x_base + g * 64 + l]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 1]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 2]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 3])));
                        dot0 += dotPacked4x8EXT(w_lo, xq_word0);

                        int hi0 = (qb0 >> 4) | (int((qh0 >> (g_shift + 1)) & 1) << 4);
                        int hi1 = (qb1 >> 4) | (int((qh1 >> (g_shift + 1)) & 1) << 4);
                        int hi2 = (qb2 >> 4) | (int((qh2 >> (g_shift + 1)) & 1) << 4);
                        int hi3 = (qb3 >> 4) | (int((qh3 >> (g_shift + 1)) & 1) << 4);
                        int w_hi = pack32(i8vec4(int8_t(hi0), int8_t(hi1),
                                                  int8_t(hi2), int8_t(hi3)));
                        int xq_word1 = pack32(i8vec4(int8_t(xq_shared[x_base + g * 64 + l + 32]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 33]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 34]),
                                                      int8_t(xq_shared[x_base + g * 64 + l + 35])));
                        dot1 += dotPacked4x8EXT(w_hi, xq_word1);
                    }
                    sumi += s0 * dot0 + s1 * dot1;
                    summ += m0 * (xq_bsums[ib] + xq_bsums[ib+1]); ib += 2;
                    summ += m1 * (xq_bsums[ib] + xq_bsums[ib+1]); ib += 2;
                    is += 2;
                }
                acc = fma(xd, d * float(sumi) - dmin * float(summ), acc);
            }
        }
        barrier();
    }

    if (!valid) return;
#ifdef HAS_RESIDUAL
    y[y_off + i] = acc + residual[r_off + i];
#else
    y[y_off + i] = acc;
#endif
}
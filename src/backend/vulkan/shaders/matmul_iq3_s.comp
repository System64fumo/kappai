#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

layout(local_size_x_id = 0) in;

layout(constant_id = 2) const int TILE_K = 2048;

layout(set = 0, binding = 0) readonly buffer W0Buf { uint w0[]; };
layout(set = 0, binding = 1) readonly buffer XBuf { float x[]; };
#ifdef HAS_RESIDUAL
layout(set = 0, binding = 2) readonly buffer RBuf { float residual[]; };
layout(set = 0, binding = 3) writeonly buffer Y0Buf { float y0[]; };
#define IQ3S_GRID_BINDING 4
#else
layout(set = 0, binding = 2) writeonly buffer Y0Buf { float y0[]; };
#define IQ3S_GRID_BINDING 3
#endif

layout(push_constant) uniform Params {
    int n0;
    int n1;
    int k;
    int m;
} params;

#include "common.glsl"
#include "iq3s_grid.glsl"

#define W_NAME w0
#define W_PFX w0_
#include "weight_io.glsl"
#undef W_NAME
#undef W_PFX

const int BLOCK = 256;
const int BLOCKS_PER_TILE = TILE_K / BLOCK;
const uint IQ3_S_BLOCK_BYTES = 110u;

shared float x_shared[TILE_K];
shared int   xq_shared[TILE_K];
shared float xq_d[BLOCKS_PER_TILE];

void main() {
    uint i   = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationID.x;
    int  k   = params.k;

    int blocks_per_row = k / 256;
    uint row_stride = uint(blocks_per_row) * IQ3_S_BLOCK_BYTES;

    uint row = gl_WorkGroupID.y;
    uint x_off = row * uint(k);
    uint y0_off = row * uint(params.n0);
#ifdef HAS_RESIDUAL
    uint r_off = y0_off;
#endif

    precise float acc0 = 0.0;
    bool valid0 = (int(i) < params.n0);

    for (int tile_start = 0; tile_start < k; tile_start += TILE_K) {
        int tile_end = min(tile_start + TILE_K, k);
        int tile_len = tile_end - tile_start;

        for (int j = int(tid); j < tile_len; j += int(gl_WorkGroupSize.x)) {
            x_shared[j] = x[x_off + uint(tile_start + j)];
        }
        barrier();

        int block_start = tile_start / 256;
        int block_end   = tile_end / 256;

        for (int bi = block_start + int(tid); bi < block_end; bi += int(gl_WorkGroupSize.x)) {
            int x_base = bi * 256 - tile_start;
            float maxv = 0.0, amax = 0.0;
            for (int j = 0; j < 256; j++) {
                float ax = abs(x_shared[x_base + j]);
                if (ax > amax) { amax = ax; maxv = x_shared[x_base + j]; }
            }
            int local_bi = bi - block_start;
            if (amax == 0.0) {
                xq_d[local_bi] = 0.0;
                for (int j = 0; j < 256; j++) xq_shared[x_base + j] = 0;
            } else {
                float iscale = -127.0 / maxv;
                for (int j = 0; j < 256; j++) {
                    int v = nearest_int(iscale * x_shared[x_base + j]);
                    if (v > 127) v = 127;
                    if (v < -127) v = -127;
                    xq_shared[x_base + j] = v;
                }
                xq_d[local_bi] = 1.0 / iscale;
            }
        }
        barrier();

        if (valid0) {
            uint row_off = i * row_stride;

            for (int bi = block_start; bi < block_end; bi++) {
                uint block_off = row_off + uint(bi) * IQ3_S_BLOCK_BYTES;
                float d_w = half_to_float(w0_read_u16(block_off));

                int local_bi = bi - block_start;
                int x_base = bi * 256 - tile_start;
                float xd = xq_d[local_bi];
                float d = d_w * xd;

                uint qs_off    = block_off + 2u;
                uint qh_off    = block_off + 66u;
                uint signs_off = block_off + 74u;
                uint scales_off = block_off + 106u;

                int total = 0;

                for (int ib32 = 0; ib32 < 8; ib32 += 2) {
                    int step = ib32 / 2;
                    uint scale_byte = w0_read_u8(scales_off + uint(step));
                    int sc1 = 1 + 2 * int(scale_byte & 0xFu);
                    int sc2 = 1 + 2 * int(scale_byte >> 4u);

                    uint qh0 = w0_read_u8(qh_off + uint(step) * 2u);
                    uint qh1 = w0_read_u8(qh_off + uint(step) * 2u + 1u);

                    int group_sum1 = 0;
                    uint qs_base1 = qs_off + uint(step) * 16u;
                    uint signs_base1 = signs_off + uint(step) * 8u;
                    for (int l = 0; l < 4; l++) {
                        uint q2l   = w0_read_u8(qs_base1 + uint(2 * l));
                        uint q2l1  = w0_read_u8(qs_base1 + uint(2 * l + 1));
                        uint gidx1 = q2l  | ((qh0 << uint(8 - 2 * l)) & 256u);
                        uint gidx2 = q2l1 | ((qh0 << uint(7 - 2 * l)) & 256u);

                        uint gw1 = iq3s_grid_word(gidx1);
                        uint gw2 = iq3s_grid_word(gidx2);
                        int g1_0 = int((gw1 >>  0u) & 0xFFu);
                        int g1_1 = int((gw1 >>  8u) & 0xFFu);
                        int g1_2 = int((gw1 >> 16u) & 0xFFu);
                        int g1_3 = int((gw1 >> 24u) & 0xFFu);
                        int g2_0 = int((gw2 >>  0u) & 0xFFu);
                        int g2_1 = int((gw2 >>  8u) & 0xFFu);
                        int g2_2 = int((gw2 >> 16u) & 0xFFu);
                        int g2_3 = int((gw2 >> 24u) & 0xFFu);

                        uint sign_byte = w0_read_u8(signs_base1 + uint(l));
                        int s0 = (sign_byte & 1u)  != 0u ? -g1_0 : g1_0;
                        int s1 = (sign_byte & 2u)  != 0u ? -g1_1 : g1_1;
                        int s2 = (sign_byte & 4u)  != 0u ? -g1_2 : g1_2;
                        int s3 = (sign_byte & 8u)  != 0u ? -g1_3 : g1_3;
                        int s4 = (sign_byte & 16u) != 0u ? -g2_0 : g2_0;
                        int s5 = (sign_byte & 32u) != 0u ? -g2_1 : g2_1;
                        int s6 = (sign_byte & 64u) != 0u ? -g2_2 : g2_2;
                        int s7 = (sign_byte & 128u)!= 0u ? -g2_3 : g2_3;

                        int base_x = x_base + ib32 * 32 + l * 8;
                        group_sum1 += s0 * xq_shared[base_x + 0];
                        group_sum1 += s1 * xq_shared[base_x + 1];
                        group_sum1 += s2 * xq_shared[base_x + 2];
                        group_sum1 += s3 * xq_shared[base_x + 3];
                        group_sum1 += s4 * xq_shared[base_x + 4];
                        group_sum1 += s5 * xq_shared[base_x + 5];
                        group_sum1 += s6 * xq_shared[base_x + 6];
                        group_sum1 += s7 * xq_shared[base_x + 7];
                    }

                    int group_sum2 = 0;
                    uint qs_base2 = qs_base1 + 8u;
                    uint signs_base2 = signs_base1 + 4u;
                    for (int l = 0; l < 4; l++) {
                        uint q2l   = w0_read_u8(qs_base2 + uint(2 * l));
                        uint q2l1  = w0_read_u8(qs_base2 + uint(2 * l + 1));
                        uint gidx1 = q2l  | ((qh1 << uint(8 - 2 * l)) & 256u);
                        uint gidx2 = q2l1 | ((qh1 << uint(7 - 2 * l)) & 256u);

                        uint gw1 = iq3s_grid_word(gidx1);
                        uint gw2 = iq3s_grid_word(gidx2);
                        int g1_0 = int((gw1 >>  0u) & 0xFFu);
                        int g1_1 = int((gw1 >>  8u) & 0xFFu);
                        int g1_2 = int((gw1 >> 16u) & 0xFFu);
                        int g1_3 = int((gw1 >> 24u) & 0xFFu);
                        int g2_0 = int((gw2 >>  0u) & 0xFFu);
                        int g2_1 = int((gw2 >>  8u) & 0xFFu);
                        int g2_2 = int((gw2 >> 16u) & 0xFFu);
                        int g2_3 = int((gw2 >> 24u) & 0xFFu);

                        uint sign_byte = w0_read_u8(signs_base2 + uint(l));
                        int s0 = (sign_byte & 1u)  != 0u ? -g1_0 : g1_0;
                        int s1 = (sign_byte & 2u)  != 0u ? -g1_1 : g1_1;
                        int s2 = (sign_byte & 4u)  != 0u ? -g1_2 : g1_2;
                        int s3 = (sign_byte & 8u)  != 0u ? -g1_3 : g1_3;
                        int s4 = (sign_byte & 16u) != 0u ? -g2_0 : g2_0;
                        int s5 = (sign_byte & 32u) != 0u ? -g2_1 : g2_1;
                        int s6 = (sign_byte & 64u) != 0u ? -g2_2 : g2_2;
                        int s7 = (sign_byte & 128u)!= 0u ? -g2_3 : g2_3;

                        int base_x = x_base + ib32 * 32 + 32 + l * 8;
                        group_sum2 += s0 * xq_shared[base_x + 0];
                        group_sum2 += s1 * xq_shared[base_x + 1];
                        group_sum2 += s2 * xq_shared[base_x + 2];
                        group_sum2 += s3 * xq_shared[base_x + 3];
                        group_sum2 += s4 * xq_shared[base_x + 4];
                        group_sum2 += s5 * xq_shared[base_x + 5];
                        group_sum2 += s6 * xq_shared[base_x + 6];
                        group_sum2 += s7 * xq_shared[base_x + 7];
                    }

                    total += sc1 * group_sum1 + sc2 * group_sum2;
                }

                acc0 = fma(d, float(total), acc0);
            }
        }
        barrier();
    }

#if defined(HAS_RESIDUAL)
    if (valid0) y0[y0_off + i] = acc0 + residual[r_off + i];
#else
    if (valid0) y0[y0_off + i] = acc0;
#endif
}

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#ifndef WG
#define WG 64
#endif
#define MAX_SUBGROUPS 16
#if defined(Q6_K)
#define PARTS 16u
#else
#define PARTS 8u
#endif
#define XQ_BLOCK_WORDS 76u
#define XQ_BLOCK_UVEC4 19u

layout(local_size_x = WG) in;
layout(constant_id = 0) const uint COLS = 1;
layout(constant_id = 1) const uint ROWS = 2;

#if defined(Q4_K) || defined(Q5_K)
layout(set = 0, binding = 0) readonly buffer W128 {
	uvec4 w128[];
};
layout(set = 0, binding = 1) readonly buffer XQ4 {
	uvec4 xq4[];
};
#else
layout(set = 0, binding = 0) readonly buffer W {
	uint16_t w16[];
};
#endif
layout(set = 0, binding = 1) readonly buffer XQ {
	uint xq[];
};
layout(set = 0, binding = 2) buffer Y {
	float y[];
};
layout(set = 0, binding = 3) readonly buffer R {
	float res[];
};

layout(push_constant) uniform Params {
	int n;
	int kb;
	int m;
	int res_mode;
}
pc;

#if defined(Q4_K)
#define BLOCK_U128 9u
#define QS_U128 1u
#elif defined(Q5_K)
#define BLOCK_U128 11u
#define QS_U128 3u
#elif defined(Q6_K)
#define BLOCK_U16 105u
#endif

int dot2(uint w0, uint w1, uint x0, uint x1) {
	return dotPacked4x8EXT(int(w0), int(x0)) + dotPacked4x8EXT(int(w1), int(x1));
}

#if defined(Q4_K) || defined(Q5_K)
struct xpart {
	uvec4 lo;
	uvec4 hi;
	float d;
	int	  sum_lo;
	int	  sum_hi;
};

int dot4(uvec4 w, uvec4 x) {
	return dot2(w.x, w.y, x.x, x.y) + dot2(w.z, w.w, x.z, x.w);
}

xpart load_xpart(uint xblock, uint g, uint qq2) {
	xpart xp;
	uint  xb4 = xblock * XQ_BLOCK_UVEC4 + 4u * g + qq2;
	xp.lo	  = xq4[xb4];
	xp.hi	  = xq4[xb4 + 2u];
	xp.d	  = uintBitsToFloat(xq[xblock * XQ_BLOCK_WORDS + 64u]);
	xp.sum_lo = dot4(uvec4(0x01010101u), xp.lo);
	xp.sum_hi = dot4(uvec4(0x01010101u), xp.hi);
	return xp;
}

void scale_min(uvec3 s, uint g, out int sc0, out int sc1, out int mn0, out int mn1) {
	uint shift = (g & 1u) * 16u;
	uint xs	   = (s.x >> shift) & 0xFFFFu;
	uint ys	   = (s.y >> shift) & 0xFFFFu;
	uint scs, mns;
	if (g < 2u) {
		scs = xs & 0x3F3Fu;
		mns = ys & 0x3F3Fu;
	} else {
		uint zs = (s.z >> shift) & 0xFFFFu;
		scs		= (zs & 0x0F0Fu) | ((xs & 0xC0C0u) >> 2u);
		mns		= ((zs >> 4u) & 0x0F0Fu) | ((ys & 0xC0C0u) >> 2u);
	}
	sc0 = int(scs & 0xFFu);
	sc1 = int(scs >> 8u);
	mn0 = int(mns & 0xFFu);
	mn1 = int(mns >> 8u);
}

float block_part(uint blk, uint part, xpart xp) {
	uint  g	   = part >> 1u;
	uint  base = blk * BLOCK_U128;
	uvec4 hdr  = w128[base];
	uvec4 q	   = w128[base + QS_U128 + part];
	uvec4 l	   = q & 0x0F0F0F0Fu;
	uvec4 h	   = (q >> 4u) & 0x0F0F0F0Fu;
#ifdef Q5_K
	uvec4 e = w128[base + 1u + (part & 1u)];
	l |= ((e >> (2u * g)) & 0x01010101u) << 4u;
	h |= ((e >> (2u * g + 1u)) & 0x01010101u) << 4u;
#endif
	int s0, s1, m0, m1;
	scale_min(hdr.yzw, g, s0, s1, m0, m1);
	int	 sumi = s0 * dot4(l, xp.lo) + s1 * dot4(h, xp.hi);
	int	 summ = m0 * xp.sum_lo + m1 * xp.sum_hi;
	vec2 dm	  = unpackHalf2x16(hdr.x);
	return xp.d * (dm.x * float(sumi) - dm.y * float(summ));
}
#else
uint wq16(uint i) {
	return uint(w16[i]);
}

uint wq32(uint i) {
	return wq16(i) | (wq16(i + 1u) << 16u);
}

uint sub_bytes(uint v, uint k) {
	return ((v | 0x80808080u) - k) ^ 0x80808080u;
}

float block_part(uint b, uint xbase, uint p) {
	uint h	  = p >> 3u;
	uint sub  = (p >> 2u) & 1u;
	uint qq	  = p & 3u;
	uint qlo  = b + h * 32u + sub * 16u + qq * 4u;
	uint qho  = b + 64u + h * 16u + qq * 4u;
	uint ql0  = wq32(qlo);
	uint ql1  = wq32(qlo + 2u);
	uint qh0  = wq32(qho);
	uint qh1  = wq32(qho + 2u);
	uint sl	  = sub * 2u;
	uint lo0  = sub_bytes((ql0 & 0x0F0F0F0Fu) | (((qh0 >> sl) & 0x03030303u) << 4u), 0x20202020u);
	uint lo1  = sub_bytes((ql1 & 0x0F0F0F0Fu) | (((qh1 >> sl) & 0x03030303u) << 4u), 0x20202020u);
	uint hi0  = sub_bytes(((ql0 >> 4u) & 0x0F0F0F0Fu) | (((qh0 >> (sl + 4u)) & 0x03030303u) << 4u),
						  0x20202020u);
	uint hi1  = sub_bytes(((ql1 >> 4u) & 0x0F0F0F0Fu) | (((qh1 >> (sl + 4u)) & 0x03030303u) << 4u),
						  0x20202020u);
	uint w_lo = h * 128u + sub * 32u + qq * 8u;
	uint w_hi = w_lo + 64u;
	uint j_lo = w_lo >> 4u;
	uint j_hi = w_hi >> 4u;
	int	 s_lo = bitfieldExtract(int(wq16(b + 96u + (j_lo >> 1u))), int((j_lo & 1u) * 8u), 8);
	int	 s_hi = bitfieldExtract(int(wq16(b + 96u + (j_hi >> 1u))), int((j_hi & 1u) * 8u), 8);
	uint xa	  = xbase + (w_lo >> 2u);
	uint xb	  = xbase + (w_hi >> 2u);
	int	 sumi =
		s_lo * dot2(lo0, lo1, xq[xa], xq[xa + 1u]) + s_hi * dot2(hi0, hi1, xq[xb], xq[xb + 1u]);
	float d	 = unpackHalf2x16(wq16(b + 104u)).x;
	float xd = uintBitsToFloat(xq[xbase + 64u]);
	return d * xd * float(sumi);
}
#endif

shared float s_red[16 * MAX_SUBGROUPS];
#ifdef SHARED_REDUCE
shared float s_part[8 * WG];
#endif

void main() {
	uint tid  = gl_LocalInvocationID.x;
	uint n	  = uint(pc.n);
	uint m	  = uint(pc.m);
	uint kb	  = uint(pc.kb);
	uint row0 = gl_WorkGroupID.x * ROWS;
	uint col0 = gl_WorkGroupID.y * COLS;

	float acc[ROWS * COLS];
	for (uint i = 0u; i < ROWS * COLS; i++)
		acc[i] = 0.0;

#if defined(Q4_K) || defined(Q5_K)
	uint wrow[ROWS];
	for (uint r = 0u; r < ROWS; r++)
		wrow[r] = min(row0 + r, n - 1u) * kb;
	uint xcol[COLS];
	for (uint c = 0u; c < COLS; c++)
		xcol[c] = min(col0 + c, m - 1u) * kb;

	for (uint it = tid; it < kb * PARTS; it += WG) {
		uint  bi = it / PARTS;
		uint  pp = it % PARTS;
		xpart xp[COLS];
		for (uint c = 0u; c < COLS; c++)
			xp[c] = load_xpart(xcol[c] + bi, pp >> 1u, pp & 1u);
		for (uint r = 0u; r < ROWS; r++)
			for (uint c = 0u; c < COLS; c++)
				acc[r * COLS + c] += block_part(wrow[r] + bi, pp, xp[c]);
	}
#else
	for (uint it = tid; it < kb * PARTS; it += WG) {
		uint bi = it / PARTS;
		uint pp = it % PARTS;
		for (uint r = 0u; r < ROWS; r++) {
			uint b = (min(row0 + r, n - 1u) * kb + bi) * BLOCK_U16;
			for (uint c = 0u; c < COLS; c++) {
				uint xbase = (min(col0 + c, m - 1u) * kb + bi) * XQ_BLOCK_WORDS;
				acc[r * COLS + c] += block_part(b, xbase, pp);
			}
		}
	}

#endif

#ifdef SHARED_REDUCE
	for (uint i = 0u; i < ROWS * COLS; i++)
		s_part[i * WG + tid] = acc[i];
#else
	for (uint i = 0u; i < ROWS * COLS; i++) {
		float v = subgroupAdd(acc[i]);
		if (subgroupElect())
			s_red[i * MAX_SUBGROUPS + gl_SubgroupID] = v;
	}
#endif
	barrier();
	if (tid >= ROWS * COLS)
		return;
	uint r	 = tid / COLS;
	uint c	 = tid % COLS;
	uint row = row0 + r;
	uint col = col0 + c;
	if (row >= n || col >= m)
		return;
	float v = 0.0;
#ifdef SHARED_REDUCE
	for (uint s = 0u; s < WG; s++)
		v += s_part[tid * WG + s];
#else
	for (uint s = 0u; s < gl_NumSubgroups; s++)
		v += s_red[tid * MAX_SUBGROUPS + s];
#endif
	uint yi = col * n + row;
	if (pc.res_mode == 1)
		y[yi] = v + res[row];
	else if (pc.res_mode == 2)
		y[yi] += v;
	else
		y[yi] = v;
}
